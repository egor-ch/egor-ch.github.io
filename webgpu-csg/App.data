// Перевод basic_sphere.frag (GLSL) на WGSL.
// Полноэкранный треугольник + sphere tracing двух шаров со smooth union.

// ------------------------------------------------------------------
// Uniforms: аналог u_resolution, u_mouse, u_time из GLSL.
// Размер структуры: 24 байта (6 значений f32).
// ------------------------------------------------------------------
struct Uniforms {
    resolution    : vec2f, // размер поверхности в пикселях
    camera_angles : vec2f, // углы камеры (phi, theta), накопленные drag'ом мыши на стороне C++
    time          : f32,   // время в секундах (сейчас камерой не управляет, но остаётся доступным)
    camera_r      : f32,   // расстояние камеры от начала координат (зум колесом мыши)
    level_max     : f32,   // level_max воксельного дерева (сторона мелкой сетки = 2^level_max)
    debug_mode    : f32,   // 0 = обычный рендер, 1 = тепловая карта traversed voxels,
                           // 2 = тепловая карта длины списка индексов листа-хита,
                           // 3 = тепловая карта итераций поиска корня,
                           // 4 = как 1, но обход останавливается на первом непустом
                           //     листе, куда вошёл луч, вообще не ища корень
    aabb_min      : vec3f, // домен сцены = корневой воксель дерева
    camera_f      : f32,   // фокусное расстояние виртуального экрана (для перспективной проекции)
    aabb_max      : vec3f,
    trace_mode    : f32,   // поиск корня внутри листа: 0 = sphere tracing,
                           // 1 = интервальная бисекция, 2 = интервальная regula falsi,
                           // 3 = интервальный ITP
    // Показ границ листьев-вокселей. Это НЕ режим отладки, а отдельный
    // переключатель: рёбра рисуются поверх любого debug_mode.
    show_edges    : f32,   // > 0.5 — включено
    edge_width    : f32,   // доля стороны вокселя: хорда короче неё считается ребром
    // Отсечка внутренних узлов целиком позади камеры (> 0.5 — включена).
    // Выключатель нужен только для сравнения производительности до/после.
    cull_behind   : f32,
    // Точность поиска корня, задаётся слайдером ImGui (лог-шкала 1e-6..1e-1).
    // Для sphere tracing (trace_mode 0) это порог попадания |f| < eps,
    // для интервальных методов — ширина отрезка, на которой деление
    // останавливается (бывший компайл-тайм ROOT_EPS).
    eps           : f32,
    // Точка, вокруг которой камера вращается и на которую смотрит. Левая
    // кнопка мыши крутит камеру ВОКРУГ неё, колесо меняет радиус, правая
    // переносит её саму в плоскости экрана (панорамирование).
    camera_target : vec3f,
    pad0          : f32,
    // Хвост блока держал скульпт (точка под курсором и параметры правок).
    // Скульпт убран, а размер оставлен прежним: application.hpp объявляет ту
    // же структуру на 32 слова, и укорачивать её пришлось бы с обеих сторон
    // разом ради 32 байт.
    pad1          : vec4f,
    pad2          : vec4f,
};

@group(0) @binding(0) var<uniform> u : Uniforms;

// ------------------------------------------------------------------
// CSG-программа: линеаризованное в RPN дерево, загружается из C++.
// Два буфера:
//  * instructions — поток инструкций с ЕДИНЫМ шагом: vec2u(opcode,
//    payload_ptr). Указатель — индекс в payload (в единицах vec4f);
//    у операций без параметров он не используется и равен 0.
//  * payload — данные инструкций:
//      примитив:  5 vec4f — 4 колонки ОБРАТНОЙ матрицы (world -> local)
//                 + vec4f(p0, p1, p2, 0) с параметрами формы;
//      smooth-оп: 1 vec4f — (k, 0, 0, 0).
// Параметры формы: сфера — p0 = радиус; box — p0..p2 = ДЛИНЫ сторон;
// цилиндр — p0 = радиус, p1 = полная высота (вдоль оси Y);
// полупространство — p0..p2 = единичная нормаль; circleXY — p0 = радиус;
// конус — p0, p1 = синус и косинус полуугла.
// Опкоды совпадают с константами csg::OP_* в ResourceManager.h.
// ------------------------------------------------------------------
@group(0) @binding(1) var<storage, read> instructions : array<vec2u>;
@group(0) @binding(2) var<storage, read> payload : array<vec4f>;

// ------------------------------------------------------------------
// Воксельный octree над CSG-программой (см. VoxelTreeData в
// ResourceManager.h). Узел — vec4u:
//   x: упакованный якорь ijk (i | j<<10 | k<<20) в единицах мелкой сетки
//   y: уровень; бит 31 = лист
//   z: внутренний узел -> индекс первого из 8 подряд идущих детей;
//      лист -> смещение в leaf_indices
//   w: лист -> число индексов (0 = пустой воксель)
// Узел 0 — корень, он покрывает AABB сцены из uniforms.
// leaf_indices — конкатенированные списки: какие инструкции полной
// RPN-программы ещё значимы внутри данного листа.
// ------------------------------------------------------------------
@group(0) @binding(3) var<storage, read> nodes : array<vec4u>;
@group(0) @binding(4) var<storage, read> leaf_indices : array<u32>;

const OP_SPHERE           : u32 = 0u; // push: расстояние до сферы
const OP_UNION            : u32 = 1u; // pop 2, push min
const OP_SMOOTH_UNION     : u32 = 2u; // pop 2, push smooth min (параметр k)
const OP_INTERSECT        : u32 = 3u; // pop 2, push max
const OP_SMOOTH_INTERSECT : u32 = 4u; // pop 2, push smooth max (параметр k)
const OP_BOX              : u32 = 5u; // push: расстояние до прямоугольного бокса
const OP_NEGATION         : u32 = 6u; // унарная: f -> -f (вычитание = intersect(A, -B))
const OP_CYLINDER         : u32 = 7u; // push: расстояние до цилиндра вдоль оси Y
const OP_HALFSPACE        : u32 = 8u; // push: полупространство (p0..p2 = нормаль)
const OP_CIRCLE_XY        : u32 = 9u; // push: бесконечный цилиндр вдоль оси Z (p0 = радиус)
const OP_CONE_BODY        : u32 = 10u; // push: бесконечное тело конуса (p0 = sin, p1 = cos полуугла)

// Собирает mat4x4f из 4 подряд идущих vec4f payload'а (это колонки) —
// четыре векторных чтения вместо 16 скалярных.
fn read_mat4(base : u32) -> mat4x4f {
    return mat4x4f(payload[base], payload[base + 1u], payload[base + 2u], payload[base + 3u]);
}

struct VertexOutput {
    @builtin(position) position : vec4f,
    // Во fragment shader это поле становится координатами фрагмента
    // в пикселях — аналог gl_FragCoord, но с началом в ЛЕВОМ ВЕРХНЕМ углу.
};

// ------------------------------------------------------------------
// Vertex shader: один треугольник, накрывающий весь экран.
// Vertex buffer не нужен; вызывайте pass.draw(3).
// ------------------------------------------------------------------
@vertex
fn vs_main(@builtin(vertex_index) vertex_index : u32) -> VertexOutput {
    var positions = array<vec2f, 3>(
        vec2f(-1.0, -1.0),
        vec2f( 3.0, -1.0),
        vec2f(-1.0,  3.0),
    );
    var out : VertexOutput;
    out.position = vec4f(positions[vertex_index], 0.0, 1.0);
    return out;
}

// ------------------------------------------------------------------
// Сцена
// ------------------------------------------------------------------
const PI : f32 = 3.1415;

// SDF-функции примитивов (sphere_dist, box_dist, cylinder_dist, ...)
// живут в отдельном файле resources/primitives.wgsl — он склеивается
// с этим файлом при создании shader module в InitializePipeline.

fn rotate3D(v : vec3f, axis : vec3f, angle : f32) -> vec3f {
    let n_axis = normalize(axis);
    let s = sin(angle);
    let c = cos(angle);
    // Rodrigues' rotation formula
    return v * c + cross(n_axis, v) * s + n_axis * dot(n_axis, v) * (1.0 - c);
}

fn unionOp(lhs : f32, rhs : f32) -> f32 {
    // return (lhs + rhs - sqrt(lhs * lhs + rhs * rhs));
    let p = 6.0f;
    return (lhs + rhs - pow(pow(lhs, p) + pow(rhs, p), 1.f/p));
    // return min(lhs, rhs);
}

fn smoothUnionOp(lhs : f32, rhs : f32, k : f32) -> f32 {
    let d = abs(rhs - lhs);
    return min(lhs, rhs) - 1.0 / (4.0 * k) * pow(max(k - d, 0.0), 2.0);
}

fn intersectOp(lhs : f32, rhs : f32) -> f32 {
    return max(lhs, rhs);
}

// Smooth intersection — это smooth union, отражённый через знак SDF:
// max(a, b) с тем же квадратичным сглаживанием шва.
fn smoothIntersectOp(lhs : f32, rhs : f32, k : f32) -> f32 {
    return -smoothUnionOp(-lhs, -rhs, k);
}

// ------------------------------------------------------------------
// Интерпретатор CSG-дерева: стековая машина над RPN-программой.
// Примитивы кладут своё расстояние на стек, операции снимают два
// значения и кладут результат. После корректной программы на стеке
// остаётся ровно одно значение — расстояние до всей сцены.
// Лево-вложенная цепочка (prim, prim, op, prim, op, ...) использует
// всего 2 слота стека независимо от числа примитивов.
// ------------------------------------------------------------------
const STACK_SIZE : u32 = 8u;

fn dist(r : vec3f) -> f32 {
    var stack : array<f32, STACK_SIZE>;
    var sp : u32 = 0u; // указатель на первый свободный слот
    let n = arrayLength(&instructions);
    for (var i = 0u; i < n; i = i + 1u) {
        let inst = instructions[i]; // (opcode, указатель в payload)
        let op = inst.x;
        let base = inst.y;
        if (op == OP_SPHERE || op == OP_BOX || op == OP_CYLINDER
            || op == OP_HALFSPACE || op == OP_CIRCLE_XY || op == OP_CONE_BODY) {
            let inv = read_mat4(base);         // world -> local
            let params = payload[base + 4u];   // (p0, p1, p2, 0)
            let p_local = (inv * vec4f(r, 1.0)).xyz;
            var d_local : f32;
            if (op == OP_SPHERE) {
                d_local = sphere_dist(p_local, params.x); // p0 = радиус
            } else if (op == OP_BOX) {
                // p0..p2 — длины сторон, SDF работает с полуразмерами
                d_local = box_round_dist(p_local, params.xyz * 0.5,
                                         payload[base + 5u], payload[base + 6u].xy);
            } else if (op == OP_CYLINDER) {
                // цилиндр вдоль оси Y: p0 = радиус, p1 = полная высота
                d_local = cylinder_dist(p_local, params.x, params.y);
            } else if (op == OP_HALFSPACE) {
                d_local = halfspace_dist(p_local, params.xyz);
            } else if (op == OP_CIRCLE_XY) {
                d_local = circle_xy_dist(p_local, params.x);
            } else {
                // конус: p0, p1 — синус и косинус полуугла
                d_local = cone_body_dist(p_local, params.x, params.y);
            }
            // Компенсация РАВНОМЕРНОГО масштаба: длина колонки обратной
            // матрицы равна 1/s, а расстояние в local-единицах надо
            // перевести обратно в world: d_world = d_local * s.
            // Неравномерный масштаб SDF не переживает — не используйте его.
            // let inv_scale = length(inv[0].xyz);
            let inv_scale = 1.0;
            stack[sp] = d_local / inv_scale;
            sp = sp + 1u;
        } else if (op == OP_NEGATION) {
            // Унарная операция: f -> -f. Вычитание A \ B кодируется как
            // A, B, NEGATION, INTERSECT (т.е. max(A, -B)).
            stack[sp - 1u] = -stack[sp - 1u];
        } else {
            // Бинарные операции: pop 2, push 1. k читается из payload
            // только smooth-вариантами; у жёстких указатель не используется.
            let rhs = stack[sp - 1u];
            sp = sp - 1u;
            let lhs = stack[sp - 1u];
            var res : f32;
            switch op {
                case OP_UNION:            { res = unionOp(lhs, rhs); }
                case OP_SMOOTH_UNION:     { res = smoothUnionOp(lhs, rhs, payload[base].x); }
                case OP_INTERSECT:        { res = intersectOp(lhs, rhs); }
                case OP_SMOOTH_INTERSECT: { res = smoothIntersectOp(lhs, rhs, payload[base].x); }
                default:                  { res = lhs; } // неизвестный опкод
            }
            stack[sp - 1u] = res;
        }
    }
    return stack[0u];
}

// Как dist(), но исполняет только инструкции из списка листа:
// leaf_indices[offset .. offset+count) — индексы в полном потоке
// instructions. Внутри своего вокселя результат совпадает с dist().
// Единый шаг инструкций делает такой выборочный доступ тривиальным.
fn dist_leaf(r : vec3f, offset : u32, count : u32) -> f32 {
    var stack : array<f32, STACK_SIZE>;
    var sp : u32 = 0u;
    for (var idx = 0u; idx < count; idx = idx + 1u) {
        let inst = instructions[leaf_indices[offset + idx]];
        let op = inst.x;
        let base = inst.y;
        if (op == OP_SPHERE || op == OP_BOX || op == OP_CYLINDER
            || op == OP_HALFSPACE || op == OP_CIRCLE_XY || op == OP_CONE_BODY) {
            let inv = read_mat4(base);
            let params = payload[base + 4u];
            let p_local = (inv * vec4f(r, 1.0)).xyz;
            var d_local : f32;
            if (op == OP_SPHERE) {
                d_local = sphere_dist(p_local, params.x);
            } else if (op == OP_BOX) {
                d_local = box_round_dist(p_local, params.xyz * 0.5,
                                         payload[base + 5u], payload[base + 6u].xy);
            } else if (op == OP_CYLINDER) {
                d_local = cylinder_dist(p_local, params.x, params.y);
            } else if (op == OP_HALFSPACE) {
                d_local = halfspace_dist(p_local, params.xyz);
            } else if (op == OP_CIRCLE_XY) {
                d_local = circle_xy_dist(p_local, params.x);
            } else {
                // конус: p0, p1 — синус и косинус полуугла
                d_local = cone_body_dist(p_local, params.x, params.y);
            }
            stack[sp] = d_local;
            sp = sp + 1u;
        } else if (op == OP_NEGATION) {
            stack[sp - 1u] = -stack[sp - 1u];
        } else {
            let rhs = stack[sp - 1u];
            sp = sp - 1u;
            let lhs = stack[sp - 1u];
            var res : f32;
            switch op {
                case OP_UNION:            { res = unionOp(lhs, rhs); }
                case OP_SMOOTH_UNION:     { res = smoothUnionOp(lhs, rhs, payload[base].x); }
                case OP_INTERSECT:        { res = intersectOp(lhs, rhs); }
                case OP_SMOOTH_INTERSECT: { res = smoothIntersectOp(lhs, rhs, payload[base].x); }
                default:                  { res = lhs; }
            }
            stack[sp - 1u] = res;
        }
    }
    return stack[0u];
}

// Интервальная версия dist_leaf(): та же программа листа, но точка
// задана параллелепипедом (IV3), а результат — интервал, гарантированно
// содержащий ВСЕ значения dist_leaf() на этом параллелепипеде.
// C++-аналог — FRepExpression::eval_optimal с RetT = SimpleIF, который
// в hit() передаётся в find_t_root_* как eval_interval.
//
// Программа листа корректна только внутри его вокселя, поэтому
// вызывать имеет смысл лишь для брусков, лежащих в вокселе.
fn dist_leaf_iv(r : IV3, offset : u32, count : u32) -> vec2f {
    var stack : array<vec2f, STACK_SIZE>;
    var sp : u32 = 0u;
    for (var idx = 0u; idx < count; idx = idx + 1u) {
        let inst = instructions[leaf_indices[offset + idx]];
        let op = inst.x;
        let base = inst.y;
        if (op == OP_SPHERE || op == OP_BOX || op == OP_CYLINDER
            || op == OP_HALFSPACE || op == OP_CIRCLE_XY || op == OP_CONE_BODY) {
            let inv = read_mat4(base);
            let params = payload[base + 4u];
            let p_local = iv_transform(inv, r);
            var d_local : vec2f;
            if (op == OP_SPHERE) {
                d_local = sphere_dist_iv(p_local, params.x);
            } else if (op == OP_BOX) {
                d_local = box_round_dist_iv(p_local, params.xyz * 0.5,
                                            payload[base + 5u], payload[base + 6u].xy);
            } else if (op == OP_CYLINDER) {
                d_local = cylinder_dist_iv(p_local, params.x, params.y);
            } else if (op == OP_HALFSPACE) {
                d_local = halfspace_dist_iv(p_local, params.xyz);
            } else if (op == OP_CIRCLE_XY) {
                d_local = circle_xy_dist_iv(p_local, params.x);
            } else {
                d_local = cone_body_dist_iv(p_local, params.x, params.y);
            }
            stack[sp] = d_local;
            sp = sp + 1u;
        } else if (op == OP_NEGATION) {
            stack[sp - 1u] = iv_neg(stack[sp - 1u]);
        } else {
            let rhs = stack[sp - 1u];
            sp = sp - 1u;
            let lhs = stack[sp - 1u];
            var res : vec2f;
            switch op {
                case OP_UNION:            { res = union_op_iv(lhs, rhs); }
                case OP_SMOOTH_UNION:     { res = smooth_union_op_iv(lhs, rhs, payload[base].x); }
                case OP_INTERSECT:        { res = intersect_op_iv(lhs, rhs); }
                case OP_SMOOTH_INTERSECT: { res = smooth_intersect_op_iv(lhs, rhs, payload[base].x); }
                default:                  { res = lhs; }
            }
            stack[sp - 1u] = res;
        }
    }
    return stack[0u];
}

// AABB отрезка луча r(t), t из [t_range.x, t_range.y]. Для интервальной
// арифметики это и есть «точка» — ровно то, что делает C++-версия:
// r(i) = RetT{origin(i)} + t * direction(i).
fn ray_segment_box(origin : vec3f, dir : vec3f, t_range : vec2f) -> IV3 {
    var box : IV3;
    box.x = iv_mul_s(t_range, dir.x) + iv_point(origin.x);
    box.y = iv_mul_s(t_range, dir.y) + iv_point(origin.y);
    box.z = iv_mul_s(t_range, dir.z) + iv_point(origin.z);
    return box;
}

// ------------------------------------------------------------------
// Поиск первого корня на отрезке луча интервальной бисекцией.
// Порт find_t_root_interval_bisection() из voxel_tree.hpp: явный стек
// t-подотрезков вместо рекурсии, DFS слева направо, поэтому первый
// подтверждённый корень — ближайший.
//
// В отличие от sphere tracing НЕ требует, чтобы функция была SDF:
// достаточно, чтобы интервальная оценка была корректной.
// ------------------------------------------------------------------

// Бисекция делит отрезок пополам, поэтому глубина DFS ограничена
// log2(ширина / u.eps), а в стеке висит не больше одного «правого
// брата» на уровень. 32 хватает вплоть до eps = 1e-6 на домене ~1
// (глубина ~21); точность поиска задаётся слайдером (u.eps).
const RF_STACK_MAX : u32 = 32u;
const RF_MAX_ITERS : u32 = 128u;  // страховка от зависания на патологии
// Допуск в проверке «интервал накрывает ноль». C++ сравнивает
// произведение границ с 10 * epsilon; здесь сравниваются сами границы —
// то же по смыслу, но без переполнения/потери значимости в f32.
const ZERO_TOL     : f32 = 1e-4;

struct RootResult {
    found : bool,
    t     : f32,
    iters : u32, // число снятых со стека подотрезков (для отладки)
};

fn find_root_bisection(
    origin : vec3f, dir : vec3f, offset : u32, count : u32, t_lo : f32, t_hi : f32,
) -> RootResult {
    var result : RootResult;
    result.found = false;
    result.iters = 0u;

    var stack : array<vec2f, RF_STACK_MAX>;
    stack[0] = vec2f(t_lo, t_hi);
    var sp : u32 = 1u;

    while (sp > 0u && result.iters < RF_MAX_ITERS) {
        result.iters = result.iters + 1u;
        sp = sp - 1u;
        let t = stack[sp];
        if (t.y < 0.0) { continue; } // подотрезок целиком позади камеры

        let f = dist_leaf_iv(ray_segment_box(origin, dir, t), offset, count);
        if (!iv_has_zero(f, ZERO_TOL)) { continue; } // корня здесь заведомо нет

        if (iv_width(t) < u.eps) {
            // Отрезок достаточно узок: подтверждаем сменой знака на его
            // концах (интервальная оценка могла накрыть ноль с запасом).
            let f_lo = dist_leaf(origin + dir * t.x, offset, count);
            let f_hi = dist_leaf(origin + dir * t.y, offset, count);
            if (min(f_lo, f_hi) <= ZERO_TOL && max(f_lo, f_hi) >= -ZERO_TOL) {
                result.found = true;
                result.t = t.x;
                return result;
            }
            continue;
        }

        // Правую половину кладём первой, чтобы левая снялась раньше:
        // так первый найденный корень — ближайший.
        if (sp + 2u <= RF_STACK_MAX) {
            let mid = 0.5 * (t.x + t.y);
            stack[sp] = vec2f(mid, t.y);
            sp = sp + 1u;
            stack[sp] = vec2f(t.x, mid);
            sp = sp + 1u;
        }
    }
    return result;
}

// ------------------------------------------------------------------
// Модификация regula falsi для поиска ПЕРВОГО корня — порт
// find_t_root_interval_falsi_new() из voxel_tree.hpp.
//
// Отличие от бисекции: отрезок делится не пополам, а двумя точками
// mid_1 <= mid_2, полученными линейной интерполяцией по f в концах, —
// сходимость заметно быстрее (на тестовых лучах 13-14 итераций против
// 22-24 у бисекции), но за итерацию добавляется одно СКАЛЯРНОЕ
// вычисление программы листа (f в левом конце) поверх интервального.
//
// СОГЛАШЕНИЕ О ЗНАКЕ. C++-оригинал написан для соглашения ядра
// (f > 0 ВНУТРИ тела) и ищет первый корень возрастающей функции:
// отсюда условие `f.upper() > 0` и формулы интерполяции. Здесь всё
// в SDF (отрицательно внутри), поэтому вводится g = -f — соглашение
// ядра — и формулы переносятся из C++ ДОСЛОВНО в терминах g. Так
// перенос проверяем построчно и не зависит от переделки алгебры.
// ------------------------------------------------------------------

// Делений три на итерацию, и они не половинят отрезок, поэтому стек
// растёт быстрее, чем у бисекции: не больше 2 «братьев» на уровень.
// Замеры на тестовых лучах: 13 в норме, 21 в патологии (весь отрезок
// внутри тела). 48 — запас; при переполнении поддерево отбрасывается
// (возможен пропуск корня), но переполнения не происходит.
const FALSI_STACK_MAX : u32 = 48u;
// Знаменатель интерполяции g.upper() - g(lower) неотрицателен (верхняя
// граница не меньше значения в точке), но может выродиться в ноль.
const FALSI_DENOM_EPS : f32 = 1e-20;

fn find_root_falsi(
    origin : vec3f, dir : vec3f, offset : u32, count : u32, t_lo : f32, t_hi : f32,
) -> RootResult {
    var result : RootResult;
    result.found = false;
    result.iters = 0u;

    var stack : array<vec2f, FALSI_STACK_MAX>;
    stack[0] = vec2f(t_lo, t_hi);
    var sp : u32 = 1u;

    while (sp > 0u && result.iters < RF_MAX_ITERS) {
        result.iters = result.iters + 1u;
        sp = sp - 1u;
        let t = stack[sp];
        let lower = t.x;
        let upper = t.y;
        if (upper < 0.0) { continue; }

        let f = dist_leaf_iv(ray_segment_box(origin, dir, t), offset, count);
        // g = -f, соглашение ядра: g.upper() = -f.lower().
        let g_hi = -f.x;
        // C++: if (f.upper() > 0). Отрезок, где SDF нигде не уходит
        // под ноль, корня не содержит.
        if (g_hi <= 0.0) { continue; }

        if (abs(upper - lower) < u.eps) {
            // Как в бисекции: подтверждаем сменой знака на концах.
            let f_lo = dist_leaf(origin + dir * lower, offset, count);
            let f_hi = dist_leaf(origin + dir * upper, offset, count);
            if (min(f_lo, f_hi) <= ZERO_TOL && max(f_lo, f_hi) >= -ZERO_TOL) {
                result.found = true;
                result.t = lower;
                return result;
            }
            continue;
        }

        // g в левом конце отрезка (C++: f_lower = eval_double(ray(lower))).
        let g_lo = -dist_leaf(origin + dir * lower, offset, count);
        let denom = g_hi - g_lo;
        var mid_1 : f32;
        var mid_2 : f32;
        var usable = false;
        if (denom > FALSI_DENOM_EPS) {
            mid_1 = upper + (upper - lower) * (g_lo / 8.0 - g_hi) / denom;
            mid_2 = upper + (upper - lower) * (g_hi / 8.0 - g_hi) / denom;
            // C++ кладёт точки как есть; при g(lower) > 0 (луч стартует
            // ВНУТРИ тела) они вылезают за [lower, upper], и в SimpleIF
            // получается вывернутый интервал. В f32 это ещё и NaN/inf,
            // поэтому здесь точки зажимаются и упорядочиваются.
            mid_1 = clamp(mid_1, lower, upper);
            mid_2 = clamp(mid_2, lower, upper);
            let a = min(mid_1, mid_2);
            let b = max(mid_1, mid_2);
            mid_1 = a;
            mid_2 = b;
            // Строгое вложение — иначе третий кусок совпал бы с исходным
            // отрезком и цикл не сдвинулся бы с места. NaN сюда не
            // проходит: любое сравнение с ним ложно.
            usable = mid_1 > lower && mid_2 < upper && mid_1 <= mid_2;
        }
        if (!usable) {
            // Вырожденное деление — откатываемся на трисекцию, чтобы
            // сохранить и число кусков, и гарантию сходимости.
            mid_1 = lower + (upper - lower) / 3.0;
            mid_2 = upper - (upper - lower) / 3.0;
        }

        // Порядок как в C++: правый кусок кладётся первым, левый —
        // последним, поэтому снимается он раньше всех.
        if (sp + 3u <= FALSI_STACK_MAX) {
            stack[sp] = vec2f(mid_2, upper);
            sp = sp + 1u;
            stack[sp] = vec2f(mid_1, mid_2);
            sp = sp + 1u;
            stack[sp] = vec2f(lower, mid_1);
            sp = sp + 1u;
        }
    }
    return result;
}

// ------------------------------------------------------------------
// Модификация ITP (Interpolate-Truncate-Project) для поиска ПЕРВОГО
// корня — порт find_t_root_interval_itp() из voxel_tree.hpp.
//
// Отрезок делится одной точкой x: интерполяция (regula falsi по g),
// затем усечение на delta в сторону середины, затем проекция в
// «бисекционный коридор» радиуса r вокруг середины. Коридор задаётся
// бюджетом nmax (сколько делений осталось до 2*eps) и счётчиком j
// (сколько уже потрачено), поэтому у КАЖДОГО подотрезка своя пара
// (nmax, j) — в C++ это два параллельных стека nmax_arr/j_arr.
// Здесь всё лежит в одном стеке vec4f: (lower, upper, nmax, j);
// nmax и j — небольшие целые, в f32 представимы точно.
//
// Знак — как в find_root_falsi: формулы перенесены дословно в терминах
// g = -f (соглашение ядра, g > 0 внутри тела).
//
// ВНИМАНИЕ, отличие от опубликованного ITP. В C++ написано
//   sigma = xh != xf ? ((xh - xf) > 0 ? 1 : 0) : 1.0;
// то есть sigma принимает значения {1, 0}, тогда как в статье это
// sign(xh - xf) из {1, -1}. При sigma = 0 усечение отключается, а
// проекция схлопывается в обычную середину, поэтому метод остаётся
// сходящимся, но теряет часть ускорения: на тестовых лучах
// 26/15/29 итераций против 11/11/12 у варианта со знаком.
// По умолчанию порт ДОСЛОВНЫЙ (как в C++); переключатель ниже нужен,
// чтобы можно было сравнить оба варианта, не трогая остальной код.
// ------------------------------------------------------------------
const ITP_TEXTBOOK_SIGMA : bool = true; // true -> sigma = sign(xh - xf)

// Делений два на итерацию, как у бисекции. Замеры: стек до 12.
const ITP_STACK_MAX : u32 = 32u;
const ITP_N0        : f32 = 1.0;
const ITP_KAPPA1    : f32 = 0.1;
const ITP_KAPPA2    : f32 = 2.0;
const ITP_DENOM_EPS : f32 = 1e-20;

// Бюджет делений до ширины 2*eps (C++: ceil(log2(width / (2 eps))) + n0).
fn itp_nmax(width : f32) -> f32 {
    return ceil(log2(max(width, 1e-30) / (2.0 * u.eps))) + ITP_N0;
}

fn find_root_itp(
    origin : vec3f, dir : vec3f, offset : u32, count : u32, t_lo : f32, t_hi : f32,
) -> RootResult {
    var result : RootResult;
    result.found = false;
    result.iters = 0u;

    var stack : array<vec4f, ITP_STACK_MAX>;
    stack[0] = vec4f(t_lo, t_hi, itp_nmax(t_hi - t_lo), 0.0);
    var sp : u32 = 1u;

    while (sp > 0u && result.iters < RF_MAX_ITERS) {
        result.iters = result.iters + 1u;
        sp = sp - 1u;
        let entry = stack[sp];
        let lower = entry.x;
        let upper = entry.y;
        let nmax = entry.z;
        let j = entry.w;
        if (upper < 0.0) { continue; }

        let f = dist_leaf_iv(ray_segment_box(origin, dir, entry.xy), offset, count);
        let g_hi = -f.x; // g.upper()
        if (g_hi <= 0.0) { continue; } // C++: if (f.upper() > 0)

        // Порог здесь 2*eps, а не eps, как у бисекции и falsi.
        if (abs(upper - lower) < 2.0 * u.eps) {
            let f_lo = dist_leaf(origin + dir * lower, offset, count);
            let f_hi = dist_leaf(origin + dir * upper, offset, count);
            if (min(f_lo, f_hi) <= ZERO_TOL && max(f_lo, f_hi) >= -ZERO_TOL) {
                result.found = true;
                result.t = lower;
                return result;
            }
            continue;
        }

        let xh = 0.5 * (lower + upper);
        // Радиус коридора: сколько ещё можно отклоняться от середины,
        // не потеряв бисекционную гарантию.
        let r = u.eps * exp2(nmax - j) - (upper - lower) / 2.0;
        let g_lo = -dist_leaf(origin + dir * lower, offset, count);
        let denom = g_lo - g_hi;

        var x : f32;
        if (abs(denom) > ITP_DENOM_EPS) {
            // Interpolate: regula falsi по (lower, g_lo) и (upper, g_hi).
            let xf = (upper * g_lo - lower * g_hi) / denom;
            var sigma : f32;
            if (ITP_TEXTBOOK_SIGMA) {
                sigma = select(select(-1.0, 1.0, xh > xf), 1.0, xh == xf);
            } else {
                sigma = select(select(0.0, 1.0, xh > xf), 1.0, xh == xf);
            }
            // Truncate.
            let delta = min(ITP_KAPPA1 * pow(upper - lower, ITP_KAPPA2), abs(xh - xf));
            let xt = select(xh, xf + sigma * delta, delta > 0.0);
            // Project.
            x = select(xh - sigma * r, xt, abs(xt - xh) <= r);
        } else {
            x = xh;
        }
        // C++ кладёт x как есть; в f32 деление может дать NaN/inf или
        // точку на самой границе — тогда правый кусок вырождается, а
        // log2(upper - x) уходит в -inf. Откат на середину: сравнение
        // с NaN ложно, поэтому этот случай тоже сюда попадает.
        if (!(x > lower && x < upper)) {
            x = xh;
        }

        // Правый кусок — новый поиск: свой бюджет, j = 0. Левый
        // продолжает текущий: наследует nmax и увеличивает j.
        // Кладётся вторым, поэтому снимается первым (ближний корень).
        if (sp + 2u <= ITP_STACK_MAX) {
            stack[sp] = vec4f(x, upper, itp_nmax(upper - x), 0.0);
            sp = sp + 1u;
            stack[sp] = vec4f(lower, x, nmax, j + 1.0);
            sp = sp + 1u;
        }
    }
    return result;
}

// Градиент по программе листа (как в C++-референсе: все 6 проб
// используют список листа, в котором найдено пересечение).
fn grad_leaf(r : vec3f, offset : u32, count : u32) -> vec3f {
    let eps = 1e-4;
    return vec3f(
        (dist_leaf(r + vec3f(eps, 0.0, 0.0), offset, count)
       - dist_leaf(r - vec3f(eps, 0.0, 0.0), offset, count)) / (2.0 * eps),
        (dist_leaf(r + vec3f(0.0, eps, 0.0), offset, count)
       - dist_leaf(r - vec3f(0.0, eps, 0.0), offset, count)) / (2.0 * eps),
        (dist_leaf(r + vec3f(0.0, 0.0, eps), offset, count)
       - dist_leaf(r - vec3f(0.0, 0.0, eps), offset, count)) / (2.0 * eps),
    );
}

// Градиент через центральные конечные разности.
fn grad(r : vec3f) -> vec3f {
    let eps = 1e-3; // см. примечание в сопроводительном тексте
    return vec3f(
        (dist(r + vec3f(eps, 0.0, 0.0))
       - dist(r - vec3f(eps, 0.0, 0.0))) / (2.0 * eps),
        (dist(r + vec3f(0.0, eps, 0.0))
       - dist(r - vec3f(0.0, eps, 0.0))) / (2.0 * eps),
        (dist(r + vec3f(0.0, 0.0, eps))
       - dist(r - vec3f(0.0, 0.0, eps))) / (2.0 * eps),
    );
}

fn sphere_tracing(unit_dir : vec3f, r_0 : vec3f) -> vec4f {
    let eps = 1e-3;
    var r = r_0;
    let max_steps = 100.;
    var i = 0.0;
    for (; i < max_steps; i = i + 1) {
        if (length(r) > 5.0) {
            break;
        }
        let f = dist(r);
        if (abs(f) < eps) {
            break;
        }
        r = r + unit_dir * f;
    }
    return vec4f(r, i);
}

// ------------------------------------------------------------------
// Иерархический A&W-обход воксельного дерева (порт hit() из
// voxel_tree.hpp). Стек вместо рекурсии; дети внутреннего узла
// обходятся DDA-шагами ВДОЛЬ ОБРАТНОГО луча и кладутся в стек,
// поэтому снимаются в порядке от ближнего к дальнему — первый
// подтверждённый хит гарантированно ближайший.
// ------------------------------------------------------------------
const TRAV_STACK_MAX : u32 = 48u;  // <= ~4 * level_max + запас
// Порог попадания sphere tracing и минимальный шаг задаются из ImGui: u.eps.
const LEAF_MAX_STEPS : u32 = 256u;  // шаги sphere tracing внутри одного листа

struct HitResult {
    hit         : bool,
    t           : f32,
    leaf_offset : u32,
    leaf_count  : u32,
    steps       : u32, // всего шагов обхода (для отладочной раскраски)
    // Луч прошёл по краю непустого листа (см. show_edges): длина хорды
    // внутри вокселя меньше порога, то есть луч задел ребро или скользнул
    // по грани. Именно из таких лучей и складывается каркас вокселей.
    edge        : bool,
    // Итерации поиска корня внутри листьев, просуммированные по всему лучу.
    // Аналог HitProfiling::root_finding_iterations из voxel_tree.hpp.
    // Считается в ОБОИХ режимах: шаги sphere tracing или снятые со стека
    // подотрезки бисекции. И то, и другое — одно вычисление программы
    // листа за единицу, поэтому режимы сравнимы напрямую (с поправкой на
    // то, что бисекция считает интервал, а sphere tracing — точку).
    root_iters  : u32,
};

// Слэб-тест: (t входа, t выхода) луча в боксе. inv_dir заранее
// защищён от нулевых компонент, поэтому inf/NaN не возникают.
fn ray_box_t(origin : vec3f, inv_dir : vec3f, bmin : vec3f, bmax : vec3f) -> vec2f {
    let t0 = (bmin - origin) * inv_dir;
    let t1 = (bmax - origin) * inv_dir;
    let tmin = min(t0, t1);
    let tmax = max(t0, t1);
    return vec2f(max(max(tmin.x, tmin.y), tmin.z), min(min(tmax.x, tmax.y), tmax.z));
}

fn octree_hit(origin : vec3f, direction : vec3f) -> HitResult {
    var result : HitResult;
    result.hit = false;

    // Компоненты направления, близкие к нулю, уводим от нуля: WGSL не
    // гарантирует IEEE-поведение inf/NaN, на которое опирался C++-код.
    var d = direction;
    if (abs(d.x) < 1e-8) { d.x = select(1e-8, -1e-8, d.x < 0.0); }
    if (abs(d.y) < 1e-8) { d.y = select(1e-8, -1e-8, d.y < 0.0); }
    if (abs(d.z) < 1e-8) { d.z = select(1e-8, -1e-8, d.z < 0.0); }
    let inv_dir = 1.0 / d;
    // Обратный луч для порядка обхода детей (см. комментарий выше)
    let inv_rdir = -inv_dir;
    let rdir_pos = vec3<bool>(d.x < 0.0, d.y < 0.0, d.z < 0.0); // знак ОБРАТНОГО луча
    let rstep = vec3f(
        select(-1.0, 1.0, rdir_pos.x),
        select(-1.0, 1.0, rdir_pos.y),
        select(-1.0, 1.0, rdir_pos.z),
    );

    let root_t = ray_box_t(origin, inv_dir, u.aabb_min, u.aabb_max);
    if (root_t.y < max(root_t.x, 0.0)) { return result; }

    let unit = (u.aabb_max - u.aabb_min) / exp2(u.level_max); // размер ячейки мелкой сетки

    var stack : array<u32, TRAV_STACK_MAX>;
    var stack_size : u32 = 1u;
    stack[0] = 0u; // корень

    while (stack_size > 0u) {
        result.steps = result.steps + 1u;
        stack_size = stack_size - 1u;
        let node = nodes[stack[stack_size]];
        let is_leaf = (node.y & 0x80000000u) != 0u;
        let level = f32(node.y & 0x7FFFFFFFu);
        let ijk = vec3f(
            f32(node.x & 1023u),
            f32((node.x >> 10u) & 1023u),
            f32((node.x >> 20u) & 1023u),
        );
        let bmin = u.aabb_min + ijk * unit;
        // Сторона узла в ячейках мелкой сетки; ниже её переиспользует и
        // порог каркаса рёбер — exp2 здесь один на узел.
        let node_cells = exp2(u.level_max - level);
        let bmax = bmin + unit * node_cells;

        if (is_leaf) {
            let count = node.w;
            if (count == 0u) { continue; } // пустой воксель — пропуск
            let vt = ray_box_t(origin, inv_dir, bmin, bmax);
            var t = max(vt.x, 0.0);
            if (vt.y < t) { continue; } // воксель целиком позади камеры

            // Каркас вокселей: порог берётся в долях СТОРОНЫ этого вокселя,
            // а не в мировых единицах, иначе на крупных листьях линии были
            // бы толстыми, а на мелких пропадали.
            if (u.show_edges > 0.5) {
                let side = unit.x * node_cells;
                if (vt.y - t < u.edge_width * side) {
                    result.hit = true;
                    result.edge = true;
                    result.t = t;
                    result.leaf_offset = node.z;
                    result.leaf_count = count;
                    return result;
                }
            }

            // debug_mode 4: выходим сразу, как только луч вошёл в непустой
            // лист, не запуская поиск корня вообще. Отделяет стоимость обхода
            // дерева от стоимости вычисления программы листа: root_iters
            // остаётся нулём, а steps — это ровно цена обхода.
            if (u.debug_mode >= 3.5) {
                result.hit = true;
                result.t = t;
                result.leaf_offset = node.z;
                result.leaf_count = count;
                return result;
            }

            if (u.trace_mode >= 0.5) {
                // Интервальные методы: корень ищется на всём [t, vt.y]
                // сразу, без предположения, что программа листа — SDF.
                var root : RootResult;
                if (u.trace_mode >= 2.5) {
                    root = find_root_itp(origin, d, node.z, count, t, vt.y);
                } else if (u.trace_mode >= 1.5) {
                    root = find_root_falsi(origin, d, node.z, count, t, vt.y);
                } else {
                    root = find_root_bisection(origin, d, node.z, count, t, vt.y);
                }
                result.root_iters = result.root_iters + root.iters;
                if (root.found) {
                    result.hit = true;
                    result.t = root.t;
                    result.leaf_offset = node.z;
                    result.leaf_count = count;
                    return result;
                }
                continue;
            }

            // Sphere tracing ТОЛЬКО внутри [t, vt.y]: программа листа
            // корректна лишь в его вокселе.
            for (var s = 0u; s < LEAF_MAX_STEPS; s = s + 1u) {
                result.root_iters = result.root_iters + 1u;
                let x = origin + d * t;
                let f = dist_leaf(x, node.z, count);
                if (abs(f) < u.eps) {
                    result.hit = true;
                    result.t = t;
                    result.leaf_offset = node.z;
                    result.leaf_count = count;
                    return result;
                }
                // Поле снова 1-липшицево (скульпта нет, операции жёсткие),
                // поэтому шаг — это |f| без поправок.
                let remaining = max(vt.y - t, 0.0);
                if (abs(f) >= remaining) {
                    // Шар радиуса |f| накрывает остаток сегмента в вокселе —
                    // корня в нём заведомо нет, выходим из листа.
                    break;
                }
                t = t + max(abs(f), u.eps);
            }
            continue;
        }

        // Внутренний узел: DDA по 2x2x2 детям вдоль обратного луча.
        // Вход обратного луча в узел:
        let rvt = ray_box_t(origin, inv_rdir, bmin, bmax);
        // Интервал обратного луча — это [-t_out, -t_in] прямого, поэтому
        // rvt.x > 0 означает t_out < 0: узел целиком позади камеры.
        // Без этой отсечки DDA идёт по бесконечной ПРЯМОЙ, и при камере
        // внутри сцены всё поддерево за спиной обходилось бы до листьев.
        if (u.cull_behind > 0.5 && rvt.x > 0.0) { continue; }
        let center = 0.5 * (bmin + bmax);
        // t пересечения обратным лучом центральных плоскостей
        let t_center = (center - origin) * inv_rdir;
        // Начальный октант: по оси стартуем с ближней к входу половины;
        // если центральная плоскость пересечена до входа — с дальней.
        // (сравнение t вместо восстановления точки — устойчиво в f32)
        let crossed = vec3<bool>(
            t_center.x <= rvt.x,
            t_center.y <= rvt.x,
            t_center.z <= rvt.x,
        );
        var lx = select(select(1, 0, crossed.x), select(0, 1, crossed.x), rdir_pos.x);
        var ly = select(select(1, 0, crossed.y), select(0, 1, crossed.y), rdir_pos.y);
        var lz = select(select(1, 0, crossed.z), select(0, 1, crossed.z), rdir_pos.z);

        let half_size = 0.5 * (bmax - bmin);
        while (lx >= 0 && lx < 2 && ly >= 0 && ly < 2 && lz >= 0 && lz < 2) {
            if (stack_size < TRAV_STACK_MAX) {
                stack[stack_size] = node.z + u32(lx) + 2u * u32(ly) + 4u * u32(lz);
                stack_size = stack_size + 1u;
            }
            // t выхода обратного луча из текущего ребёнка по каждой оси
            let child_min = bmin + vec3f(f32(lx), f32(ly), f32(lz)) * half_size;
            let child_center = child_min + 0.5 * half_size;
            let t_max = (child_center + 0.5 * half_size * rstep - origin) * inv_rdir;
            if (t_max.x < t_max.y) {
                if (t_max.x < t_max.z) { lx = lx + i32(rstep.x); }
                else { lz = lz + i32(rstep.z); }
            } else {
                if (t_max.y < t_max.z) { ly = ly + i32(rstep.y); }
                else { lz = lz + i32(rstep.z); }
            }
        }
    }
    return result;
}

// ------------------------------------------------------------------
// Fragment shader
// ------------------------------------------------------------------
@fragment
fn fs_main(in : VertexOutput) -> @location(0) vec4f {
    

    // Drag-to-orbit: углы приходят готовыми из C++ (накапливаются там,
    // пока зажата левая кнопка мыши; theta уже ограничен вне полюсов,
    // чтобы camera_dir не стал параллелен (0,0,1) и базис не выродился в NaN).
    // (вариант с вращением по времени оставлен закомментированным)
    // let phi = u.time * 2.0;
    // let theta = PI * 0.25;
    let phi = u.camera_angles.x;
    let theta = u.camera_angles.y;
    let camera_r = u.camera_r;
    // Смещение камеры от точки, на которую она смотрит; направление взгляда
    // задаётся только им, поэтому перенос цели камеру не разворачивает.
    let camera_offset = vec3f(
        camera_r * sin(theta) * cos(phi),
        camera_r * sin(theta) * sin(phi),
        camera_r * cos(theta),
    );
    let camera = u.camera_target + camera_offset;
    let camera_dir = -camera_offset / length(camera_offset);
    let aux_vec = cross(camera_dir, vec3f(0.0, 0.0, 1.0));
    let camera_y_unit = rotate3D(camera_dir, aux_vec, PI / 2.0);
    let camera_x_unit = cross(camera_dir, camera_y_unit);
    let f = u.camera_f; // фокусное расстояние виртуального экрана

    // Аналог: vec2 st = gl_FragCoord.xy / u_resolution;
    var st = in.position.xy / u.resolution;
    // В GLSL начало координат фрагмента — левый нижний угол,
    // в WGSL — левый верхний. Переворачиваем ось Y, чтобы
    // изображение совпадало с оригиналом.
    st.y = 1.0 - st.y;

    // Виртуальный экран — квадрат 1x1 по вертикали; по горизонтали он
    // растягивается на aspect, иначе на неквадратном окне (fullscreen)
    // изображение сплющивалось бы.
    let aspect = u.resolution.x / u.resolution.y;
    let init_pixel = camera + camera_dir * f
                   - camera_x_unit * 0.5 * aspect
                   - camera_y_unit * 0.5;
    let pixel = init_pixel + camera_x_unit * st.x * aspect + camera_y_unit * st.y;
    let dir = (pixel - camera) / length(pixel - camera);

    // Обход воксельного дерева вместо sphere tracing по всей программе
    let hit = octree_hit(camera, dir);
    let debug_mode = i32(u.debug_mode);

    // Рёбра рисуются раньше всех веток debug_mode, поэтому переключатель
    // работает одинаково с любым из них.
    if (hit.edge) {
        return vec4f(0.0, 0.0, 0.0, 1.0);
    }

    if (debug_mode == 1) {
        // Тепловая карта: число вершин дерева, обойдённых для этого луча
        // (HitResult.steps считается в octree_hit для каждого луча, попал он
        // в геометрию или нет).
        // if (hit.steps > 100u) {
        //     return vec4f(0.0, 0.0, 1.0, 1.0);
        // }
        return vec4f(f32(hit.steps) / 128.0, 0.0, 0.0, 1.0);
    }
    if (debug_mode == 2) {
        // Тепловая карта: длина списка индексов листа, в котором найден хит
        // (HitResult.leaf_count, валиден только при hit.hit == true).
        if (hit.hit) {
            // if (hit.leaf_count == 39u) {
            //     return vec4f(1.0, 0.0, 0.0, 1.0);
            // }
            return vec4f(0.0, f32(hit.leaf_count) / 64.0, 0.0, 1.0);
        }
        return vec4f(0.0, 0.0, 0.0, 1.0);
    }
    if (debug_mode == 3) {
        // Тепловая карта: итерации поиска корня внутри листьев,
        // просуммированные по всему лучу — шаги sphere tracing или
        // подотрезки бисекции, в зависимости от trace_mode.
        // if (hit.root_iters > 256u) {
        //     return vec4f(0.0, 0.0, 1.0, 1.0);
        // }
        let heat = f32(hit.root_iters) / 256.0;
        return vec4f(heat, heat, 0.0, 1.0);
    }
    if (debug_mode == 4) {
        // Та же тепловая карта, что и в режиме 1, но octree_hit вернулся на
        // первом же непустом листе: поиск корня не выполнялся ни разу.
        // Разница в FPS с режимом 1 — это цена поиска корня плюс та часть
        // обхода, которую режим 1 проходит дальше первого листа.
        // if (hit.steps > 100u) {
        //     return vec4f(0.0, 0.0, 1.0, 1.0);
        // }
        return vec4f(f32(hit.steps) / 64.0, 0.0, 0.0, 1.0);
    }

    if (hit.hit) {
        let p = camera + dir * hit.t;
        // Раскраска по нормали (градиент по программе листа, в котором
        // найден хит), приведённой из диапазона [-1, 1] в [0, 1].
        return vec4f((grad_leaf(p, hit.leaf_offset, hit.leaf_count) + 1.0) / 2.0, 1.0);
    }
    return vec4f(0.5, 0.5, 0.5, 1.0);
}
// ------------------------------------------------------------------
// Интервальная арифметика и интервальные версии SDF-примитивов.
// Файл конкатенируется с primitives.wgsl и basic_sphere.wgsl при
// создании shader module (см. InitializePipeline в application.cpp).
//
// Интервал — vec2f: .x = нижняя граница, .y = верхняя. То же
// представление, что у Interval (float2) в mpr Мэтта Китера; C++-аналог
// в ядре — arithmetic::SimpleIF.
//
// НАПРАВЛЕНИЕ ОКРУГЛЕНИЯ. В WGSL нет аналогов __fadd_rd/__fadd_ru из
// CUDA, поэтому все операции считаются в режиме «к ближайшему»: границы
// могут быть занижены/завышены на ~1 ulp. Это НЕ строгое внешнее
// (outward) округление — тонкие детали теоретически можно пропустить.
// Если понадобится строгость, достаточно расширять результат каждой
// нелинейной операции на пару ulp одним хелпером; здесь этого
// сознательно не делается (наивный порт).
//
// СОГЛАШЕНИЕ О ЗНАКЕ — как во всём шейдере: SDF, отрицательно ВНУТРИ
// тела, union = min, intersection = max. Формулы ниже повторяют
// primitives.wgsl один в один, только над интервалами.
// ------------------------------------------------------------------

// Точка (вырожденный интервал).
fn iv_point(x : f32) -> vec2f {
    return vec2f(x, x);
}

// Ширина интервала.
fn iv_width(a : vec2f) -> f32 {
    return a.y - a.x;
}

// Содержит ли интервал ноль (с допуском tol на границах).
fn iv_has_zero(a : vec2f, tol : f32) -> bool {
    return a.x <= tol && a.y >= -tol;
}

// --- Линейные операции: точные (с точностью до округления) ----------

// Сложение покомпонентное, поэтому отдельная функция не нужна: a + b.

fn iv_sub(a : vec2f, b : vec2f) -> vec2f {
    return vec2f(a.x - b.y, a.y - b.x);
}

fn iv_neg(a : vec2f) -> vec2f {
    return vec2f(-a.y, -a.x);
}

// Умножение на скаляр: знак скаляра может перевернуть границы.
fn iv_mul_s(a : vec2f, s : f32) -> vec2f {
    let p = a * s;
    return vec2f(min(p.x, p.y), max(p.x, p.y));
}

// --- Нелинейные операции -------------------------------------------

// Общее умножение: min/max из четырёх произведений границ
// (то же, что SimpleIF::multiply_bounds).
fn iv_mul(a : vec2f, b : vec2f) -> vec2f {
    let p = vec4f(a.x * b.x, a.x * b.y, a.y * b.x, a.y * b.y);
    return vec2f(
        min(min(p.x, p.y), min(p.z, p.w)),
        max(max(p.x, p.y), max(p.z, p.w)),
    );
}

// Квадрат. ВНИМАНИЕ: это НЕ iv_mul(a, a) — учёт зависимости даёт
// строго более узкую (и по-прежнему корректную) оценку: для a = [-1, 2]
// здесь получается [0, 4], а через iv_mul — [-2, 4]. C++-референс
// считает x*x общим умножением, так что интервалы на GPU могут
// оказаться уже, а число итераций бисекции — меньше.
fn iv_sqr(a : vec2f) -> vec2f {
    if (a.x >= 0.0) { return vec2f(a.x * a.x, a.y * a.y); }
    if (a.y <= 0.0) { return vec2f(a.y * a.y, a.x * a.x); }
    return vec2f(0.0, max(a.x * a.x, a.y * a.y));
}

// Модуль (аналог arithmetic::abs для SimpleIF).
fn iv_abs(a : vec2f) -> vec2f {
    if (a.x >= 0.0) { return a; }
    if (a.y <= 0.0) { return vec2f(-a.y, -a.x); }
    return vec2f(0.0, max(-a.x, a.y));
}

// min/max монотонны по обоим аргументам, поэтому покомпонентно — точно.
fn iv_min(a : vec2f, b : vec2f) -> vec2f {
    return min(a, b);
}

fn iv_max(a : vec2f, b : vec2f) -> vec2f {
    return max(a, b);
}

// Корень: отрицательная часть срезается (как в SimpleIF::sqrt).
fn iv_sqrt(a : vec2f) -> vec2f {
    let lo = max(a.x, 0.0);
    return vec2f(sqrt(lo), sqrt(max(a.y, lo)));
}

// Длина 2D/3D вектора интервалов.
fn iv_len2(x : vec2f, y : vec2f) -> vec2f {
    return iv_sqrt(iv_sqr(x) + iv_sqr(y));
}

fn iv_len3(x : vec2f, y : vec2f, z : vec2f) -> vec2f {
    return iv_sqrt(iv_sqr(x) + iv_sqr(y) + iv_sqr(z));
}

// ------------------------------------------------------------------
// Точка в интервальной арифметике — параллелепипед (AABB).
// ------------------------------------------------------------------
struct IV3 {
    x : vec2f,
    y : vec2f,
    z : vec2f,
};

// Аналог (m * vec4f(r, 1.0)).xyz для интервального r: m — обычная
// матрица f32, поэтому достаточно умножений на скаляр
// (C++-аналог: arithmetic::interval_matrix_multiply).
//
// Здесь и возникает основная потеря точности: у повёрнутого примитива
// образ бруска — повёрнутый параллелепипед, а интервалы могут описать
// только его AABB (эффект wrapping). Это свойство самой арифметики
// SimpleIF, а не порта.
fn iv_transform(m : mat4x4f, p : IV3) -> IV3 {
    var o : IV3;
    o.x = iv_mul_s(p.x, m[0].x) + iv_mul_s(p.y, m[1].x) + iv_mul_s(p.z, m[2].x) + iv_point(m[3].x);
    o.y = iv_mul_s(p.x, m[0].y) + iv_mul_s(p.y, m[1].y) + iv_mul_s(p.z, m[2].y) + iv_point(m[3].y);
    o.z = iv_mul_s(p.x, m[0].z) + iv_mul_s(p.y, m[1].z) + iv_mul_s(p.z, m[2].z) + iv_point(m[3].z);
    return o;
}

// ------------------------------------------------------------------
// Интервальные версии примитивов из primitives.wgsl.
// Каждая функция возвращает интервал, ГАРАНТИРОВАННО содержащий все
// значения соответствующей скалярной функции на бруске p.
// ------------------------------------------------------------------

fn sphere_dist_iv(p : IV3, radius : f32) -> vec2f {
    return iv_len3(p.x, p.y, p.z) - iv_point(radius);
}

// Интервальный скруглённый бокс — пара к box_round_dist в primitives.wgsl.
//
// Радиус угла выбирается по знакам координат, а интервал может накрывать
// ноль, поэтому берётся интервал ПО ВСЕМ достижимым углам: [min, max] по
// тем из четырёх, чьи знаки совместимы с входными интервалами. Когда все
// четыре радиуса равны (так во всех наших сценах), он вырождается в точку
// и никакой потери точности нет.
fn corner_radius_iv(px : vec2f, pz : vec2f, r4 : vec4f) -> vec2f {
    let xpos = px.y > 0.0;   // может ли x быть положительным
    let xneg = px.x <= 0.0;
    let zpos = pz.y > 0.0;
    let zneg = pz.x <= 0.0;
    var lo = 3.4e38;
    var hi = -3.4e38;
    if (xpos && zpos) { lo = min(lo, r4.x); hi = max(hi, r4.x); }
    if (xpos && zneg) { lo = min(lo, r4.y); hi = max(hi, r4.y); }
    if (xneg && zpos) { lo = min(lo, r4.z); hi = max(hi, r4.z); }
    if (xneg && zneg) { lo = min(lo, r4.w); hi = max(hi, r4.w); }
    return vec2f(lo, hi);
}

// Радиус входит в формулу дважды (в q и в вычитание в конце), поэтому при
// РАЗНЫХ радиусах углов оценка корректна, но шире точной — та же проблема
// зависимости, что у гладких операций.
fn round_box_2d_iv(px : vec2f, pz : vec2f, b : vec2f, r4 : vec4f) -> vec2f {
    let r = corner_radius_iv(px, pz, r4);
    let qx = iv_abs(px) - iv_point(b.x) + r;
    let qz = iv_abs(pz) - iv_point(b.y) + r;
    let zero = vec2f(0.0, 0.0);
    let outer = iv_len2(iv_max(qx, zero), iv_max(qz, zero));
    let inner = iv_min(iv_max(qx, qz), zero);
    return iv_sub(outer + inner, r);
}

fn extrude_dist_iv(d : vec2f, z : vec2f, h : vec2f, r : vec2f) -> vec2f {
    let qx = d + r;
    let qy = iv_sub(iv_abs(z), h);
    let zero = vec2f(0.0, 0.0);
    let outer = iv_len2(iv_max(qx, zero), iv_max(qy, zero));
    let inner = iv_min(iv_max(qx, qy), zero);
    return iv_sub(outer + inner, r);
}

fn box_round_dist_iv(p : IV3, b : vec3f, corners : vec4f, round_xy : vec2f) -> vec2f {
    let d2 = round_box_2d_iv(p.x, p.z, b.xz, corners);
    // Скругление торца — по знаку y; когда интервал накрывает ноль, годятся
    // оба, поэтому берётся их обхват.
    var er = vec2f(min(round_xy.x, round_xy.y), max(round_xy.x, round_xy.y));
    if (p.y.x > 0.0) {
        er = iv_point(round_xy.x);
    } else if (p.y.y <= 0.0) {
        er = iv_point(round_xy.y);
    }
    return extrude_dist_iv(d2, p.y, iv_sub(iv_point(b.y), er), er);
}

fn box_dist_iv(p : IV3, b : vec3f) -> vec2f {
    let qx = iv_abs(p.x) - iv_point(b.x);
    let qy = iv_abs(p.y) - iv_point(b.y);
    let qz = iv_abs(p.z) - iv_point(b.z);
    let zero = vec2f(0.0, 0.0);
    let outer = iv_len3(iv_max(qx, zero), iv_max(qy, zero), iv_max(qz, zero));
    let inner = iv_min(iv_max(qx, iv_max(qy, qz)), zero);
    return outer + inner;
}

fn cylinder_dist_iv(p : IV3, radius : f32, height : f32) -> vec2f {
    let dx = iv_len2(p.x, p.z) - iv_point(radius);
    let dy = iv_abs(p.y) - iv_point(height * 0.5);
    let zero = vec2f(0.0, 0.0);
    return iv_min(iv_max(dx, dy), zero) + iv_len2(iv_max(dx, zero), iv_max(dy, zero));
}

fn halfspace_dist_iv(p : IV3, n : vec3f) -> vec2f {
    return iv_neg(iv_mul_s(p.x, n.x) + iv_mul_s(p.y, n.y) + iv_mul_s(p.z, n.z));
}

fn circle_xy_dist_iv(p : IV3, radius : f32) -> vec2f {
    return iv_len2(p.x, p.y) - iv_point(radius);
}

fn cone_body_dist_iv(p : IV3, sin_a : f32, cos_a : f32) -> vec2f {
    return iv_mul_s(iv_len2(p.x, p.z), sin_a) + iv_mul_s(p.y, cos_a);
}

// ------------------------------------------------------------------
// Интервальные версии операций CSG.
// ------------------------------------------------------------------

fn union_op_iv(lhs : vec2f, rhs : vec2f) -> vec2f {
    // return iv_sub(lhs + rhs, iv_sqrt(iv_sqr(lhs) + iv_sqr(rhs))) * iv_point(1.0 / (1.0 + sqrt(2.0)));
    return iv_min(lhs, rhs);
}

fn intersect_op_iv(lhs : vec2f, rhs : vec2f) -> vec2f {
    return iv_max(lhs, rhs);
}

// lhs и rhs входят в формулу дважды (в min и в d), поэтому интервальная
// оценка КОРРЕКТНА, но заведомо шире точной области значений
// (проблема зависимости). На жёстких union/intersect этого нет.
fn smooth_union_op_iv(lhs : vec2f, rhs : vec2f, k : f32) -> vec2f {
    let d = iv_abs(iv_sub(rhs, lhs));
    let t = iv_max(iv_sub(iv_point(k), d), vec2f(0.0, 0.0));
    return iv_sub(iv_min(lhs, rhs), iv_mul_s(iv_sqr(t), 1.0 / (4.0 * k)));
}

fn smooth_intersect_op_iv(lhs : vec2f, rhs : vec2f, k : f32) -> vec2f {
    return iv_neg(smooth_union_op_iv(iv_neg(lhs), iv_neg(rhs), k));
}
// ------------------------------------------------------------------
// SDF-примитивы. Этот файл конкатенируется с основным шейдером при
// создании shader module (в WGSL нет #include; порядок объявлений на
// уровне модуля не важен, поэтому простая склейка файлов корректна).
//
// Все функции считают расстояние в ЛОКАЛЬНОЙ системе примитива:
// центр в начале координат, ось симметрии — Y. Позиция/поворот
// задаются обратной матрицей в ленте CSG-программы, а не здесь.
// ------------------------------------------------------------------

// Сфера радиуса radius с центром в начале координат.
fn sphere_dist(p : vec3f, radius : f32) -> f32 {
    return length(p) - radius;
}

// Бокс с ПОЛУразмерами b, центр в начале координат (Inigo Quilez).
// Снаружи — расстояние до ближайшей грани/ребра/угла, внутри — отрицательное.
fn box_dist(p : vec3f, b : vec3f) -> f32 {
    let q = abs(p) - b;
    return length(max(q, vec3f(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

// ------------------------------------------------------------------
// Скруглённый бокс — тот же примитив, что в эталонной реализации статьи
// (eval_prim/PRIMITIVE_BOX в LipschitzPruning/shaders/common.glsl): не
// параллелепипед, а двумерный скруглённый прямоугольник в плоскости XZ,
// выдавленный вдоль Y со скруглением торцов. Радиусы четырёх углов
// независимы, у верхнего и нижнего торца свой радиус. Это ОДИН примитив,
// а не поддерево из боксов и цилиндров: всё лежит в payload инструкции.
//
// При нулевых радиусах формулы вырождаются в обычный box_dist.
// ------------------------------------------------------------------

// Углы нумеруются по знакам (x, z): r.x = (+,+), r.y = (+,-), r.z = (-,+),
// r.w = (-,-) — порядок эталона.
fn round_box_2d(p : vec2f, b : vec2f, r4 : vec4f) -> f32 {
    let rx = select(r4.zw, r4.xy, p.x > 0.0);
    let r = select(rx.y, rx.x, p.y > 0.0);
    let q = abs(p) - b + vec2f(r);
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2f(0.0))) - r;
}

// Выдавливание двумерного профиля d на полувысоту h со скруглением r.
fn extrude_dist(d : f32, z : f32, h : f32, r : f32) -> f32 {
    let q = vec2f(d + r, abs(z) - h);
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2f(0.0))) - r;
}

// b — ПОЛУразмеры, corners — радиусы углов в XZ, round_xy — скругление
// верхнего (p.y > 0) и нижнего торца. Скругление торца съедает высоту:
// полувысота профиля равна b.y - r, как в эталоне.
fn box_round_dist(p : vec3f, b : vec3f, corners : vec4f, round_xy : vec2f) -> f32 {
    let d2 = round_box_2d(p.xz, b.xz, corners);
    let er = select(round_xy.y, round_xy.x, p.y > 0.0);
    return extrude_dist(d2, p.y, b.y - er, er);
}

// Цилиндр вдоль оси Y: радиус radius, ПОЛНАЯ высота height.
fn cylinder_dist(p : vec3f, radius : f32, height : f32) -> f32 {
    let d = vec2f(length(p.xz) - radius, abs(p.y) - height * 0.5);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0)));
}

// ------------------------------------------------------------------
// Примитивы из FRep-ядра (primitives.hpp). Там принято соглашение
// f > 0 ВНУТРИ тела; наш трассировщик ждёт SDF (отрицательно внутри),
// поэтому формулы ядра записаны здесь с обратным знаком. Для обоих
// примитивов ниже отрицание даёт ТОЧНОЕ расстояние.
// ------------------------------------------------------------------

// Полупространство: граница проходит через начало локальных координат,
// n — ЕДИНИЧНАЯ нормаль, тело лежит с той стороны, куда она указывает.
// (в ядре: f = dot(n, p); здесь знак обращён под SDF)
fn halfspace_dist(p : vec3f, n : vec3f) -> f32 {
    return -dot(n, p);
}

// "CircleXY" ядра: radius - sqrt(x^2 + y^2), т.е. бесконечный цилиндр
// вдоль ЛОКАЛЬНОЙ оси Z (координата z не участвует).
fn circle_xy_dist(p : vec3f, radius : f32) -> f32 {
    return length(p.xy) - radius;
}

// Бесконечное тело конуса: вершина в начале координат, раскрытие вдоль -Y,
// полуугол задаётся отношением radius/height. Параметры приходят из C++ уже
// нормированными (как в конструкторе ConeBody ядра):
//   sin_a = height / sqrt(height^2 + radius^2)
//   cos_a = radius / sqrt(height^2 + radius^2)
// (в ядре: f = -sin_a*q - cos_a*y; здесь знак обращён под SDF)
// Снаружи это ТОЧНОЕ расстояние; в области «за вершиной» — заниженная,
// то есть безопасная для sphere tracing, оценка.
// Тело бесконечно вдоль -Y: чтобы получить конечный конус, его пересекают
// с полупространством (в сценах это уже сделано деревом CSG).
fn cone_body_dist(p : vec3f, sin_a : f32, cos_a : f32) -> f32 {
    return sin_a * length(p.xz) + cos_a * p.y;
}

// ------------------------------------------------------------------
// Наследие первых глав: шар, заданный центром и радиусом в мировых
// координатах. Интерпретатором больше не используется.
// ------------------------------------------------------------------

struct Ball {
    r_0 : vec3f, // центр
    R   : f32,   // радиус
};

fn ball_dist(r : vec3f, ball : Ball) -> f32 {
    // В GLSL было sqrt(pow(...)) — заменено на length,
    // так как pow с отрицательным основанием формально не определён.
    return length(r - ball.r_0) - ball.R;
}

fn ball_grad(r : vec3f, ball : Ball) -> vec3f {
    return (r - ball.r_0) / length(r - ball.r_0);
}

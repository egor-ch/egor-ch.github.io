}/**
 * A structure with fields labeled with vertex attribute locations can be used
 * as input to the entry point of a shader.
 */
struct VertexInput {
    @location(0) position: vec2f,
    @location(1) color: vec3f,
};

/**
 * A structure with fields labeled with builtins and locations can also be used
 * as *output* of the vertex shader, which is also the input of the fragment
 * shader.
 */
struct VertexOutput {
    @builtin(position) position: vec4f,
    // The location here does not refer to a vertex attribute, it just means
    // that this field must be handled by the rasterizer.
    // (It can also refer to another field of another struct that would be used
    // as input to the fragment shader.)
    @location(0) color: vec3f,
};

@vertex
fn vs_main(in: VertexInput) -> VertexOutput {
    let ratio = 640.0 / 480.0; // The width and height of the target surface
    let offset = vec2f(-0.6875, -0.463); // The offset that we want to apply to the position
    var out: VertexOutput; // create the output struct
    out.position = vec4f(in.position.x + offset.x, (in.position.y + offset.y) * ratio, 0.0, 1.0);
    out.color = in.color; // forward the color attribute to the fragment shader
    return out;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4f {
    return vec4f(in.color, 1.0); // use the interpolated color coming from the vertex shader
}// ------------------------------------------------------------------
// Построение воксельного октодерева на GPU — альтернатива загрузке
// готового .voxtree (см. ResourceManager::loadVoxelTreeBinary).
//
// Дерево строится в ширину: один compute-проход на уровень. Проход d
// обрабатывает все узлы уровня (seed_level + d) параллельно, по одному
// потоку на узел, и решает, лист это или узел делится на 8 детей.
//
// Почему списков индексов ТРИ вида:
//  * final_indices — только дописывается, никогда не сбрасывается. Сюда
//    попадает список узла, который ОСТАНОВИЛСЯ. Именно этот массив
//    рендерер биндит как leaf_indices, поэтому список листа обязан
//    дожить до конца построения.
//  * frontier_in / frontier_out — «пинг-понг». Сюда попадает список
//    узла, который РАЗДЕЛИЛСЯ: его читают 8 детей на следующем проходе,
//    после чего он мёртв. Сбрасывается каждый проход.
//  * bitmask — рабочая память, свой кусок на поток, живёт только внутри
//    прохода. (Замер 2026-08: перенос её в приватный массив потока
//    замедляет построение в 7-13 раз — WGSL зануляет var при входе в
//    функцию, то есть каждый узел платит за обнуление всей полосы, а
//    scratch-память ещё и латентнее storage.)
// Узел пишет свой список ровно в один из первых двух буферов, выбирая по
// критерию листа. Поэтому список нигде не копируется, и ничего уже
// финализированного не лежит в буфере, который потом переиспользуют.
//
// Видимость данных между проходами даёт граница прохода: задачи,
// записанные проходом d, читает только проход d+1. Никакой синхронизации
// внутри диспатча не нужно.
// ------------------------------------------------------------------

struct BuildParams {
    aabb_min     : vec3f, // домен сцены = корневой воксель
    lt           : u32,   // порог сложности: при count <= lt деление прекращается
    aabb_max     : vec3f,
    level_max    : u32,   // самый глубокий уровень; узел на нём принудительно лист
    rpn_size     : u32,
    // Ёмкости в элементах. Каждое атомарное выделение сверяется с ними:
    // буферы заданы заранее, поэтому переполнение обязано выставить флаг,
    // а не писать за границу.
    node_cap     : u32,   // в узлах (vec4u)
    final_cap    : u32,   // в u32
    frontier_cap : u32,   // в u32
    task_cap     : u32,   // в u32
    bitmask_cap  : u32,   // в u32
    // Критерий отсечения: CRIT_LIPSCHITZ, CRIT_BOOLEAN или CRIT_BOOLEAN_SMOOTH.
    criterion    : u32,
    // maxComputeWorkgroupsPerDimension устройства: потолок, которым reset_out
    // обрезает размер сетки, когда задач больше, чем она покрывает.
    max_workgroups : u32,
    // Начало области битовой маски внутри final_indices, в u32.
    // Маска не отдельный биндинг, а хвост буфера листовых индексов: в
    // браузере maxStorageBuffersPerShaderStage равен 10 (у Chrome; спец
    // обещает всего 8), а отдельной маской проход просил 11 и не собирался
    // вовсе. Соседство безопасное: [0, final_cap) только дописывается
    // счётчиком globals.final_count, а [bitmask_base, +bitmask_cap) живёт
    // лишь внутри одного прохода и раздаётся счётчиком globals.bitmask_count.
    bitmask_base : u32,
};

// Липшицев критерий (prune_indices для RetT = double): скалярная оценка в
// центре вокселя, ветвь выбрасывается при |left - right| > k + 2R.
const CRIT_LIPSCHITZ : u32 = 0u;
// Булев критерий (prune_indices<PruningCriterion::Boolean>): интервальная
// оценка на всём вокселе, ветвь выбрасывается, когда её знак на вокселе
// определён и потому не влияет на результат операции.
//
// Важное отличие от липшицева: булево отсечение сохраняет ЗНАК поля, но не
// его ЗНАЧЕНИЕ. Блендинг оно НЕ учитывает — гладкие операции считаются
// жёсткими (min/max), как в ядре. Расхождение с тем, что рисует рендерер,
// ограничено k/4 на шов; липшицев критерий, наоборот, блендинг учитывает.
// Поэтому сцена для него грузится с hardOps = true (см. application.cpp):
// бленды выбрасываются из модели целиком, и рендерер идёт по той же жёсткой
// сцене, которую отсекал построитель.
const CRIT_BOOLEAN : u32 = 1u;
// Булево отсечение, которое УМЕЕТ бленды. Два прохода вместо одного; сам
// критерий и вся его механика описаны над prune_list_boolean_smooth().
const CRIT_BOOLEAN_SMOOTH : u32 = 2u;
// Критерий Китера. Тот же интервальный обход, что у булева, и отличается
// ровно одним: операнды сравниваются НЕ С НУЛЁМ, А ДРУГ С ДРУГОМ. Когда их
// интервалы не перекрываются, min/max на всём вокселе выбирает один и тот
// же операнд, и он заменяет собой всю операцию вместе со ЗНАЧЕНИЕМ — тогда
// как булев сохраняет только знак. Бленды не поддерживает: правила записаны
// для жёстких объединения и пересечения, поэтому сцену для него, как и для
// булева, грузят с hardOps (см. application.cpp).
const CRIT_KEETER : u32 = 3u;

// Счётчики, накапливаемые за всё построение; не сбрасываются.
struct Globals {
    node_count  : atomic<u32>,
    final_count : atomic<u32>,
    error       : atomic<u32>,
    // Диагностика критерия со сглаживанием: сколько гладких операций он
    // разобрал за всё построение и скольким из них не хватило ни порога
    // сохранения значения, ни знакового правила. Отношение — это и есть цена
    // блендинга: такой ненулевой бленд запирает знаковое отсечение во всём своём
    // поддереве, поэтому по нему сразу видно, упирается сцена в блокировку
    // или уже нет.
    smooth_seen : atomic<u32>,
    smooth_live : atomic<u32>,
    // Знаковые отсечения: найденные первым проходом и отвергнутые
    // вторым из-за ненулевого бленда сверху. Считать «запертые позиции» было бы
    // бессмысленно: примитив под ненулевым блендом тоже заперт, но отсекать на
    // нём всё равно нечего, поэтому такая доля от k почти не зависит.
    sign_seen    : atomic<u32>,
    sign_refused : atomic<u32>,
    // Водяной знак битовой маски: наибольшее занятое место за один проход
    // (счётчик маски сбрасывается перед каждым). По нему видно, насколько
    // ёмкость bitmask_cap переразмерена — а платится за неё временем, потому
    // что драйвер делает всю арену резидентной на каждый submit.
    bitmask_peak : atomic<u32>,
    // Фактически исполненные отсечения: сохраняющие значение и сохраняющие
    // знак. Именно они гасят биты, то есть это прямая проверка того, что
    // второй проход действительно упрощает дерево, а не только размечает.
    value_commits : atomic<u32>,
    sign_commits  : atomic<u32>,
    // Сколько позиций списка сняли знаковые отсечения. Отношение к
    // sign_commits — средний размер выброшенного поддерева вместе с самим
    // узлом операции; меньше двух означало бы, что отсечение «срабатывает»,
    // но ничего не убирает.
    sign_removed  : atomic<u32>,
    // Решающая проверка «блокировка по токенам, а не по ячейке»: знаковые
    // отсечения, случившиеся в ячейках, где ненулевой бленд ВСТРЕТИЛСЯ. При
    // блокировке «всё-или-ничего» это строго нуль: там первый же ненулевой бленд
    // запрещает знаковое правило во всей ячейке. Считать «разрешённые ПОСЛЕ
    // ненулевого бленда» нельзя: в гребне разблокированные примитивы лежат правее
    // самого верхнего ненулевого бленда, то есть обходятся до него.
    sign_in_dirty : atomic<u32>,
    // Ячейки, где ненулевого бленда не встретилось вовсе, и ячейки всего.
    cells_clean     : atomic<u32>,
    cells_total     : atomic<u32>,
    // Непустые листья — чтобы считать среднюю длину списка на ячейку.
    leaves          : atomic<u32>,
    // Сложность листа L — длина его списка активных инструкций.
    // l_max — наибольшая по всему дереву.
    // l_sum[lvl] / l_cnt[lvl] — сумма L и число листьев на уровне lvl.
    // Раскладка по уровням нужна потому, что среднее просят
    // ПРОСТРАНСТВЕННОЕ: лист уровня lvl занимает 8^-lvl домена, а листья
    // разных уровней в адаптивном дереве различаются по объёму в разы.
    // Отсюда L_avg = sum(L * 8^-lvl), знаменатель равен единице, потому что
    // листья разбивают домен без дыр и перекрытий (это и проверяется по
    // l_cnt: sum(l_cnt[lvl] * 8^-lvl) обязано дать ровно 1).
    l_max           : atomic<u32>,
    l_sum           : array<atomic<u32>, 16>,
    l_cnt           : array<atomic<u32>, 16>,
    // Счётчик выделений битовой маски. Лежит здесь, а не первым словом
    // своего буфера, потому что маска въехала в хвост final_indices, а тот
    // объявлен обычным array<u32> — атомарного слова в нём нет. Сбрасывается
    // каждым reset_out, как раньше сбрасывался счётчик самой маски.
    // Дописан В КОНЕЦ намеренно: ReadBackStats() читает счётчики по
    // фиксированным индексам, и вставка в середину сдвинула бы их все.
    bitmask_count   : atomic<u32>,
};

// Растущий список: текущая длина лежит в первом u32 буфера, кусок
// занимается через atomicAdd. В версии «только на чтение» атомарности нет:
// проход, который список читает, никогда его не пишет.
struct ListIn  { count : u32,         data : array<u32> };
struct ListOut { count : atomic<u32>, data : array<u32> };

// Биты ошибок, которые ORом накапливаются в globals.error.
const ERR_NODE     : u32 = 1u;
const ERR_FINAL    : u32 = 2u;
const ERR_FRONTIER : u32 = 4u;
const ERR_TASK     : u32 = 8u;
const ERR_BITMASK  : u32 = 16u;

@group(0) @binding(0)  var<uniform>             params        : BuildParams;
@group(0) @binding(1)  var<storage, read>       instructions  : array<vec2u>;
@group(0) @binding(2)  var<storage, read>       payload       : array<vec4f>;
// subtree_start[g] — индекс первой инструкции поддерева с корнем в g.
// Считается один раз на CPU. Нужен проходу отсечения, чтобы гасить целое
// поддерево как непрерывный диапазон индексов, а не обходить его назад.
@group(0) @binding(3)  var<storage, read>       subtree_start : array<u32>;
@group(0) @binding(4)  var<storage, read_write> nodes         : array<vec4u>;
@group(0) @binding(5)  var<storage, read_write> final_indices : array<u32>;
@group(0) @binding(6)  var<storage, read_write> globals       : Globals;
// Списки задач хранят индексы узлов. Пинг-понг: проход d читает _in, пишет _out.
@group(0) @binding(7)  var<storage, read>       task_in       : ListIn;
@group(0) @binding(8)  var<storage, read_write> task_out      : ListOut;
@group(0) @binding(9)  var<storage, read>       frontier_in   : ListIn;
@group(0) @binding(10) var<storage, read_write> frontier_out  : ListOut;
// Аргументы косвенного диспатча (x, y, z) для ближайшего прохода build().
// Настоящее число задач существует только в памяти GPU, поэтому размер
// сетки нельзя вычислить на CPU при кодировании команд — не читая счётчик
// обратно. Здесь его считает reset_out, а забирает сам GPU, когда доходит
// до следующей команды.
struct DispatchArgs { x : u32, y : u32, z : u32 };
@group(0) @binding(12) var<storage, read_write> dispatch_args : DispatchArgs;

// Опкоды — те же значения, что и константы csg::OP_* в ResourceManager.h.
const OP_SPHERE           : u32 = 0u;
const OP_UNION            : u32 = 1u;
const OP_SMOOTH_UNION     : u32 = 2u;
const OP_INTERSECT        : u32 = 3u;
const OP_SMOOTH_INTERSECT : u32 = 4u;
const OP_BOX              : u32 = 5u;
const OP_NEGATION         : u32 = 6u;
const OP_CYLINDER         : u32 = 7u;
const OP_HALFSPACE        : u32 = 8u;
const OP_CIRCLE_XY        : u32 = 9u;
const OP_CONE_BODY        : u32 = 10u;
// Скульпт-правка (см. basic_sphere.wgsl): унарная, по инструкции на правку,
// f -> f - C * (1 - r^2/R^2)^3. Обрабатывается ТОЛЬКО липшицевым критерием;
// булевым критериям сцена загружается без этих инструкций.

// Диагностика копится в приватных счётчиках потока и сливается в globals
// одним атомиком на узел. Атомик на каждую позицию списка сериализовал бы
// весь проход: позиций на порядки больше, чем узлов.
var<private> stat_smooth_seen : u32;
var<private> stat_smooth_live : u32;
var<private> stat_sign_seen     : u32;
var<private> stat_sign_refused  : u32;
var<private> stat_value_commits : u32;
// Не счётчик, а флаг: проход 1 разметил хотя бы одну жертву. Если нет,
// проход 2 не запускается вовсе — гасить ему нечего, а обратный обход
// списка это чтение маски на каждую позицию.
var<private> stat_pruned_marks  : u32;
var<private> stat_sign_commits  : u32;
var<private> stat_sign_removed  : u32;

const LEAF_BIT   : u32 = 0x80000000u;
const LEVEL_MASK : u32 = 0x7fffffffu;

// Запись списка (frontier/final) — это чистый индекс инструкции, без флагов.
// Раньше в старшем бите ехала пометка «эту гладкую операцию разрешено считать
// жёсткой», и рендерер подменял ей опкод. Теперь неотсечённый бленд не
// признаётся жёстким, а честно запирает своё поддерево (MARK_BLOCK), поэтому
// выживший гладкий узел всегда получает ИСТИННЫЕ значения операндов и
// рисуется как есть — передавать рендереру нечего.
//
// Совпадает с глубиной стека, которую проверяет loadCsgScene().
const STACK_SIZE : u32 = 16u;

fn read_mat4(base : u32) -> mat4x4f {
    return mat4x4f(payload[base], payload[base + 1u], payload[base + 2u], payload[base + 3u]);
}

fn is_primitive(op : u32) -> bool {
    return op == OP_SPHERE || op == OP_BOX || op == OP_CYLINDER
        || op == OP_HALFSPACE || op == OP_CIRCLE_XY || op == OP_CONE_BODY;
}

// Расстояние одной инструкции-примитива в мировой точке r.
fn primitive_dist(op : u32, base : u32, r : vec3f) -> f32 {
    let inv = read_mat4(base);
    let shape = payload[base + 4u];
    let p = (inv * vec4f(r, 1.0)).xyz;
    if (op == OP_SPHERE)     { return sphere_dist(p, shape.x); }
    if (op == OP_BOX)        {
        // Бокс читает на два vec4 больше: радиусы углов и скругление торцов.
        return box_round_dist(p, shape.xyz * 0.5, payload[base + 5u], payload[base + 6u].xy);
    }
    if (op == OP_CYLINDER)   { return cylinder_dist(p, shape.x, shape.y); }
    if (op == OP_HALFSPACE)  { return halfspace_dist(p, shape.xyz); }
    if (op == OP_CIRCLE_XY)  { return circle_xy_dist(p, shape.x); }
    return cone_body_dist(p, shape.x, shape.y);
}

// Квадратичное сглаживание шва — та же формула, что smoothUnionOp в
// basic_sphere.wgsl, иначе построитель отсекал бы по одному полю, а
// рендерер шёл бы по другому. При d >= k добавка ровно нулевая: на этом и
// стоит критерий отсечения (см. prune_list).
fn smooth_union_op(lhs : f32, rhs : f32, k : f32) -> f32 {
    let d = abs(rhs - lhs);
    return min(lhs, rhs) - (1.0 / (4.0 * k)) * pow(max(k - d, 0.0), 2.0);
}

// Радиус сглаживания операции: у жёстких его нет, у гладких лежит в payload
// (loadCsgScene кладёт туда k при blendRadius > 1e-5). Ноль здесь означает
// «операция жёсткая» и для гладкого опкода невозможен, но проверяется:
// деление на 4k дало бы inf * 0 = NaN и отравило бы всё дерево.
fn blend_radius(op : u32, base : u32) -> f32 {
    if (op == OP_SMOOTH_UNION || op == OP_SMOOTH_INTERSECT) {
        return max(payload[base].x, 0.0);
    }
    return 0.0;
}

fn binary_op_k(op : u32, k : f32, lhs : f32, rhs : f32) -> f32 {
    if (k > 0.0) {
        if (op == OP_SMOOTH_UNION) { return smooth_union_op(lhs, rhs, k); }
        return -smooth_union_op(-lhs, -rhs, k); // гладкое пересечение
    }
    if (op == OP_UNION || op == OP_SMOOTH_UNION) { return min(lhs, rhs); }
    if (op == OP_INTERSECT || op == OP_SMOOTH_INTERSECT) { return max(lhs, rhs); }
    return lhs;
}

// ------------------------------------------------------------------
// Битовая маска активных позиций списка. Индексы здесь ЛОКАЛЬНЫЕ: это
// позиции внутри frontier_in.data[offset .. offset+count), а не индексы
// инструкций всей RPN-программы.
//
// Гасить биты нужно именно операцией «И с дополнением», а не XOR, как в
// C++-версии: там обратный обход по next_bit/prev_bit заходит только на
// установленные биты, а диапазонная очистка ниже задевает и те, что уже
// погашены вложенным отсечением, — XOR зажёг бы их обратно.
// ------------------------------------------------------------------
fn clear_bit(bbase : u32, local : u32) {
    final_indices[params.bitmask_base + bbase + (local >> 5u)] &= ~(1u << (local & 31u));
}

fn test_bit(bbase : u32, local : u32) -> bool {
    return (final_indices[params.bitmask_base + bbase + (local >> 5u)] & (1u << (local & 31u))) != 0u;
}

// ------------------------------------------------------------------
// Полосы маски. Одноproходным критериям хватает одной — «позиция активна».
// Критерию со сглаживанием нужны ещё три, потому что решение принимается в
// первом проходе, а исполняется во втором:
//
//   BAND_ACTIVE — активные позиции, то самое, что уходит в список листа;
//   BAND_CODE0/BAND_CODE1 — два бита кода на позицию (MARK_* ниже);
//   BAND_AUX    — сторона выбрасываемой ветви (жертвы) у отсечения; у
//                 остальных кодов не читается и остаётся нулём.
//
// Полосы лежат подряд в полосе потока: база полосы b — это bbase + b*words.
// Хранить вместо этого массив структур на count элементов нельзя: он был бы
// одного порядка с самим списком, а время построения линейно по объёму
// выделенных буферов (замер: ~1.38 мс на гигабайт арены), тогда как битовые
// полосы в 32 раза мельче.
// ------------------------------------------------------------------
const BAND_ACTIVE  : u32 = 0u;
const BAND_CODE0   : u32 = 1u;
const BAND_CODE1   : u32 = 2u;
const BAND_AUX     : u32 = 3u;
const SMOOTH_BANDS : u32 = 4u;

// Код позиции. Отсечение и блокировка потомков взаимно исключают друг
// друга по построению: MARK_BLOCK ставится только там, где не сработало ни
// сохраняющее значение отсечение, ни знаковое. Поэтому четырёх состояний
// хватает, и они помещаются в две битовые полосы.
const MARK_NONE  : u32 = 0u; // ни отсечения, ни блокировки
const MARK_VALUE : u32 = 1u; // отсечение, сохраняющее ЗНАЧЕНИЕ узла
const MARK_SIGN  : u32 = 2u; // отсечение, сохраняющее только ЗНАК
const MARK_BLOCK : u32 = 3u; // ненулевой бленд: запирает знак под собой

fn mark_get(bbase : u32, words : u32, local : u32) -> u32 {
    let c0 = select(0u, 1u, test_bit(bbase + BAND_CODE0 * words, local));
    let c1 = select(0u, 2u, test_bit(bbase + BAND_CODE1 * words, local));
    return c0 | c1;
}

fn mark_set(bbase : u32, words : u32, local : u32, code : u32, aux : bool) {
    let w = local >> 5u;
    let bit = 1u << (local & 31u);
    if ((code & 1u) != 0u) { final_indices[params.bitmask_base + bbase + BAND_CODE0 * words + w] |= bit; }
    if ((code & 2u) != 0u) { final_indices[params.bitmask_base + bbase + BAND_CODE1 * words + w] |= bit; }
    if (aux) { final_indices[params.bitmask_base + bbase + BAND_AUX * words + w] |= bit; }
}

// Как clear_range, но возвращает, сколько бит ФАКТИЧЕСКИ погасила. Часть
// диапазона могла быть снята раньше — вложенным отсечением или предком, —
// поэтому номинальный размер поддерева ничего не доказывает, а этот счёт
// доказывает: он и есть число инструкций, которые отсечение убрало из списка.
fn clear_range_count(bbase : u32, lo : u32, hi : u32) -> u32 {
    let w0 = lo >> 5u;
    let w1 = hi >> 5u;
    let low_mask = 0xFFFFFFFFu << (lo & 31u);
    let high_mask = 0xFFFFFFFFu >> (31u - (hi & 31u));
    if (w0 == w1) {
        let m = low_mask & high_mask;
        let n = countOneBits(final_indices[params.bitmask_base + bbase + w0] & m);
        final_indices[params.bitmask_base + bbase + w0] &= ~m;
        return n;
    }
    var n = countOneBits(final_indices[params.bitmask_base + bbase + w0] & low_mask);
    final_indices[params.bitmask_base + bbase + w0] &= ~low_mask;
    for (var w = w0 + 1u; w < w1; w = w + 1u) {
        n = n + countOneBits(final_indices[params.bitmask_base + bbase + w]);
        final_indices[params.bitmask_base + bbase + w] = 0u;
    }
    n = n + countOneBits(final_indices[params.bitmask_base + bbase + w1] & high_mask);
    final_indices[params.bitmask_base + bbase + w1] &= ~high_mask;
    return n;
}

// Гасит биты [lo, hi] включительно, словами, а не по одному биту:
// поддерево верхних уровней — это сотни позиций.
fn clear_range(bbase : u32, lo : u32, hi : u32) {
    let w0 = lo >> 5u;
    let w1 = hi >> 5u;
    let low_mask = 0xFFFFFFFFu << (lo & 31u);        // биты (lo&31)..31
    let high_mask = 0xFFFFFFFFu >> (31u - (hi & 31u)); // биты 0..(hi&31)
    if (w0 == w1) {
        final_indices[params.bitmask_base + bbase + w0] &= ~(low_mask & high_mask);
        return;
    }
    final_indices[params.bitmask_base + bbase + w0] &= ~low_mask;
    for (var w = w0 + 1u; w < w1; w = w + 1u) {
        final_indices[params.bitmask_base + bbase + w] = 0u;
    }
    final_indices[params.bitmask_base + bbase + w1] &= ~high_mask;
}

// Гасит всё поддерево, корень которого стоит на локальной позиции `local`.
//
// Замена prune_preRPN_indices() из expression.hpp. Там поддерево искали
// обратным обходом со счётчиком арности, по одному зависимому чтению на
// элемент. Здесь используется то, что поддерево занимает непрерывный
// диапазон ГЛОБАЛЬНЫХ индексов [subtree_start[g], g], а список локальных
// позиций отсортирован по возрастанию глобального индекса. Значит,
// поддерево — это и непрерывный диапазон локальных позиций, а его начало
// находится двоичным поиском.
fn subtree_lo(offset : u32, local : u32) -> u32 {
    let lo_global = subtree_start[frontier_in.data[offset + local]];
    var lo = 0u;
    var hi = local;
    while (lo < hi) {
        let mid = (lo + hi) >> 1u;
        if (frontier_in.data[offset + mid] < lo_global) {
            lo = mid + 1u;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn clear_subtree(bbase : u32, offset : u32, local : u32) {
    clear_range(bbase, subtree_lo(offset, local), local);
}

// Элемент стека несёт и значение, и локальную позицию, которая его
// породила. В C++ вместо этого заведён массив values[] на весь список; на
// GPU такой массив в приватной памяти невозможен (его размер — до
// rpn_size), но читают из него только те элементы, что лежат на стеке,
// поэтому значение просто хранится в самом стеке. Глубина стека
// ограничена глубиной RPN-программы, которую проверяет loadCsgScene().
struct StackEl {
    value : f32,
    local : u32,
};

// Липшицево отсечение списка (порт prune_indices() из expression.hpp).
// Обходит список один раз, гасит в маске всё, что не влияет на значение
// внутри вокселя, и возвращает значение выражения в центре вокселя.
// Блендинг поддерживается: у гладкой операции порог отсечения вырастает на
// её радиус k (см. ниже).
//
// Обход идёт подряд по всем позициям, а не по установленным битам:
// отсечение гасит только позиции СТРОГО ЛЕВЕЕ текущей (своё поддерево и
// сам узел операции), поэтому пропускать заранее нечего.
fn prune_list(p : vec3f, radius : f32, offset : u32, count : u32, bbase : u32) -> f32 {
    var stack : array<StackEl, STACK_SIZE>;
    var sp : u32 = 0u;
    for (var i = 0u; i < count; i = i + 1u) {
        let inst = instructions[frontier_in.data[offset + i]];
        let op = inst.x;
        if (is_primitive(op)) {
            if (sp >= STACK_SIZE) { return 0.0; }
            stack[sp] = StackEl(primitive_dist(op, inst.y, p), i);
            sp = sp + 1u;
        } else if (op == OP_NEGATION) {
            if (sp == 0u) { return 0.0; }
            stack[sp - 1u] = StackEl(-stack[sp - 1u].value, i);
        } else {
            if (sp < 2u) { return 0.0; }
            let right = stack[sp - 1u];
            let left = stack[sp - 2u];
            sp = sp - 1u;
            // Критерий Липшица: |a - b| > k + 2R. Оба поля 1-липшицевы,
            // поэтому внутри вокселя радиуса R их разность меняется не
            // более чем на 2R; если в центре она больше k + 2R, то по
            // всему вокселю она больше k — а при таком расхождении
            // блендинг тождественно нулевой (см. smooth_union_op) и
            // операция вырождается в свой победивший операнд. У жёсткой
            // операции k = 0, то есть прежнее условие |a - b| > 2R.
            let k = blend_radius(op, inst.y);
            if (abs(right.value - left.value) > k + 2.0 * radius) {
                // Выигрывает та ветвь, чьё значение и есть результат
                // операции. В соглашении SDF (внутри отрицательно)
                // объединение — это min, пересечение — max, то есть
                // наоборот по сравнению с ядром FRep.
                let is_union = op == OP_UNION || op == OP_SMOOTH_UNION;
                var prune_left = left.value < right.value; // max: побеждает больший
                if (is_union) {
                    prune_left = left.value > right.value; // min: побеждает меньший
                }
                var victim : StackEl;
                var survivor : StackEl;
                if (prune_left) {
                    victim = left;
                    survivor = right;
                } else {
                    victim = right;
                    survivor = left;
                }
                // Сам узел операции тоже исчезает: на его месте в стеке
                // остаётся выживший операнд со СВОЕЙ локальной позицией.
                clear_bit(bbase, i);
                clear_subtree(bbase, offset, victim.local);
                stack[sp - 1u] = survivor;
            } else {
                // k уже прочитан выше — binary_op() перечитал бы payload.
                stack[sp - 1u] = StackEl(binary_op_k(op, k, left.value, right.value), i);
            }
        }
    }
    if (sp == 0u) { return 0.0; }
    // Делить на сертификат Липшица больше не нужно: он был нужен скульпту,
    // под правками которого поле переставало быть 1-липшицевым. Операции
    // теперь только жёсткие, min/max 1-липшицевость сохраняют, и |root| > R
    // честен как есть.
    return stack[0].value;
}

// Интервальная версия primitive_dist(): вместо точки — брусок вокселя.
fn primitive_dist_iv(op : u32, base : u32, r : IV3) -> vec2f {
    let inv = read_mat4(base);
    let shape = payload[base + 4u];
    let p = iv_transform(inv, r);
    if (op == OP_SPHERE)     { return sphere_dist_iv(p, shape.x); }
    if (op == OP_BOX)        {
        return box_round_dist_iv(p, shape.xyz * 0.5, payload[base + 5u], payload[base + 6u].xy);
    }
    if (op == OP_CYLINDER)   { return cylinder_dist_iv(p, shape.x, shape.y); }
    if (op == OP_HALFSPACE)  { return halfspace_dist_iv(p, shape.xyz); }
    if (op == OP_CIRCLE_XY)  { return circle_xy_dist_iv(p, shape.x); }
    return cone_body_dist_iv(p, shape.x, shape.y);
}

fn binary_op_iv(op : u32, lhs : vec2f, rhs : vec2f) -> vec2f {
    if (op == OP_UNION || op == OP_SMOOTH_UNION) { return union_op_iv(lhs, rhs); }
    if (op == OP_INTERSECT || op == OP_SMOOTH_INTERSECT) { return intersect_op_iv(lhs, rhs); }
    return lhs;
}

fn is_union_op(op : u32) -> bool {
    return op == OP_UNION || op == OP_SMOOTH_UNION;
}

struct StackElIv {
    value : vec2f, // (нижняя, верхняя) граница
    local : u32,
};

struct PruneChoice {
    prune      : bool,
    prune_left : bool, // true — выбрасывается ЛЕВЫЙ операнд
};

// Булев критерий: каждый операнд сравнивается С НУЛЁМ. Сохраняет ЗНАК
// результата, но не значение.
fn choose_boolean(left : vec2f, right : vec2f, is_union : bool) -> PruneChoice {
    let left_inside   = left.y  < 0.0;
    let left_outside  = left.x  > 0.0;
    let right_inside  = right.y < 0.0;
    let right_outside = right.x > 0.0;
    if (left_inside || right_outside) {
        // Ядро: bit_to_prune = is_union ? right : left
        return PruneChoice(true, !is_union);
    }
    if (left_outside || right_inside) {
        // Ядро: bit_to_prune = is_union ? left : right
        return PruneChoice(true, is_union);
    }
    return PruneChoice(false, false);
}

// Критерий Китера: операнды сравниваются ДРУГ С ДРУГОМ. Если их интервалы не
// перекрываются, min/max выбирает один и тот же операнд по всему вокселю, и
// тот заменяет операцию целиком — со значением, а не только со знаком.
// Интервал результата при этом в точности равен интервалу выжившего, поэтому
// оценка остаётся честной оболочкой поля.
//
// В таблице статьи правила записаны в соглашении FRep (внутри f > 0,
// объединение — max), здесь принято соглашение SDF (внутри f < 0,
// объединение — min), поэтому пары зеркальны. Формулировка от соглашения не
// зависит: min(A, B) = A ровно тогда, когда интервал A целиком не выше
// интервала B, и симметрично для max.
fn choose_keeter(left : vec2f, right : vec2f, is_union : bool) -> PruneChoice {
    if (is_union) {
        // Объединение — min: выживает тот, чей интервал целиком НИЖЕ.
        if (left.y  <= right.x) { return PruneChoice(true, false); } // остаётся левый
        if (right.y <= left.x)  { return PruneChoice(true, true);  } // остаётся правый
    } else {
        // Пересечение — max: выживает тот, чей интервал целиком ВЫШЕ.
        if (left.x  >= right.y) { return PruneChoice(true, false); }
        if (right.x >= left.y)  { return PruneChoice(true, true);  }
    }
    return PruneChoice(false, false);
}

// Булево отсечение списка — порт prune_indices<PruningCriterion::Boolean>.
// Возвращает интервал значений выражения на вокселе.
//
// Ядро FRep считает, что ВНУТРИ тела f > 0, а здесь принято соглашение SDF
// (внутри отрицательно), поэтому все состояния зеркальны:
//   Inside  (ядро: lower > 0)  ->  здесь upper < 0
//   Outside (ядро: upper < 0)  ->  здесь lower > 0
// Объединение при этом min, а не max, — то есть ровно так же зеркально,
// поэтому выбор выбрасываемой ветви от ядра не отличается.
fn prune_list_interval(voxel : IV3, offset : u32, count : u32, bbase : u32,
                       keeter : bool) -> vec2f {
    var stack : array<StackElIv, STACK_SIZE>;
    var sp : u32 = 0u;
    for (var i = 0u; i < count; i = i + 1u) {
        let inst = instructions[frontier_in.data[offset + i]];
        let op = inst.x;
        if (is_primitive(op)) {
            if (sp >= STACK_SIZE) { return vec2f(0.0, 0.0); }
            stack[sp] = StackElIv(primitive_dist_iv(op, inst.y, voxel), i);
            sp = sp + 1u;
        } else if (op == OP_NEGATION) {
            if (sp == 0u) { return vec2f(0.0, 0.0); }
            stack[sp - 1u] = StackElIv(iv_neg(stack[sp - 1u].value), i);
        } else {
            if (sp < 2u) { return vec2f(0.0, 0.0); }
            let right = stack[sp - 1u];
            let left = stack[sp - 2u];
            sp = sp - 1u;

            let is_union = op == OP_UNION || op == OP_SMOOTH_UNION;

            var choice : PruneChoice;
            if (keeter) {
                choice = choose_keeter(left.value, right.value, is_union);
            } else {
                choice = choose_boolean(left.value, right.value, is_union);
            }

            if (choice.prune) {
                var victim : StackElIv;
                var survivor : StackElIv;
                if (choice.prune_left) {
                    victim = left;
                    survivor = right;
                } else {
                    victim = right;
                    survivor = left;
                }
                clear_bit(bbase, i);
                clear_subtree(bbase, offset, victim.local);
                stack[sp - 1u] = survivor;
            } else {
                stack[sp - 1u] = StackElIv(binary_op_iv(op, left.value, right.value), i);
            }
        }
    }
    if (sp == 0u) { return vec2f(0.0, 0.0); }
    return stack[0].value;
}

// ------------------------------------------------------------------
// БУЛЕВО ОТСЕЧЕНИЕ СО СГЛАЖИВАНИЕМ (CRIT_BOOLEAN_SMOOTH), проход 1.
//
// Зачем отдельный критерий. Знаковое (булево) правило на гладкой операции
// незаконно: su(a, b) = min(a, b) - φ, и φ > 0 может утащить результат под
// ноль там, где min ещё положителен. Разойтись знаки могут ТОЛЬКО когда оба
// операнда лежат в полосе [0, k) — тогда φ достигает min(a, b). Отсюда весь
// критерий: у гладкой операции порог «заведомо снаружи» поднимается с нуля
// до k, и на этом знаковое правило снова становится законным.
//
// Две проверки на узел, именно в этом порядке:
//
//  1. Сохранение ЗНАЧЕНИЯ (Keeter/Липшиц): |a - b| > k + 2R. Тогда φ ≡ 0,
//     операция тождественно равна победившему операнду, и проигравшую ветку
//     можно выбросить БЕЗУСЛОВНО — значение узла не меняется, и никого выше
//     это не касается.
//  2. Знаковое правило Duff с порогом thr: операнд «заведомо внутри»
//     (a + R <= 0) или «заведомо снаружи» (a - R >= thr). У жёсткой операции
//     thr = 0, и это дословно prune_list_interval; у гладкой thr = k.
//
// Операция, которой не хватило ни того ни другого, — НЕНУЛЕВОЙ БЛЕНД: он
// потребляет значения операндов, а знаковое отсечение их меняет, поэтому под
// ним резать по знаку нельзя. Такой узел получает MARK_BLOCK и запирает своё
// поддерево. Жёсткая операция без жертвы не запирает никого: цепочка из
// min/max определяет знак результата по одним знакам операндов.
//
// Почему проход не отсекает. Порог обязан считаться на ИСТИННЫХ значениях
// операндов: знаковое отсечение значения меняет, и проверяй мы порог по уже
// упрощённым, к нему пришлось бы добавлять сумму смещений всех упрощённых
// потомков, а она растёт с глубиной. Поэтому проход только размечает, а гасит
// биты второй проход. Из этого же следует, что число в вершине стека — это
// значение НЕупрощённого выражения, и проверка «ячейка пуста» по нему честна.
//
// Обратное направление (можно ли резать под этим узлом) знает только проход 2:
// предки в постфиксной записи стоят ПРАВЕЕ потомков.
//
// ОЦЕНКА НА ВОКСЕЛЕ — липшицева: |f - f(центр)| <= R, потому что все примитивы
// и все операторы Quilez 1-липшицевы. Интервальная арифметика не нужна и
// вдобавок слабее: на ней одной критерий проигрывал липшицеву на Trees в
// 1.4 раза по узлам — у повёрнутого примитива образ бруска есть повёрнутый
// параллелепипед, а интервалы описывают только его AABB.
// ------------------------------------------------------------------
fn prune_list_boolean_smooth(center : vec3f, radius : f32,
                             offset : u32, count : u32,
                             bbase : u32, words : u32) -> f32 {
    // На стеке одно число — значение в центре вокселя. Границы получаются из
    // него и радиуса, поэтому хранить их незачем, и стек тут ровно такой же,
    // как у липшицева prune_list().
    //
    // Позиции операндов здесь тоже не нужны: список за проход не меняется, и
    // проход 2 восстанавливает их по subtree_start.
    var stack : array<f32, STACK_SIZE>;
    var sp : u32 = 0u;
    for (var i = 0u; i < count; i = i + 1u) {
        let inst = instructions[frontier_in.data[offset + i]];
        let op = inst.x;
        if (is_primitive(op)) {
            if (sp >= STACK_SIZE) { return 0.0; }
            stack[sp] = primitive_dist(op, inst.y, center);
            sp = sp + 1u;
        } else if (op == OP_NEGATION) {
            if (sp == 0u) { return 0.0; }
            stack[sp - 1u] = -stack[sp - 1u];
        } else {
            if (sp < 2u) { return 0.0; }
            let right = stack[sp - 1u];
            let left = stack[sp - 2u];
            sp = sp - 1u;

            let k = blend_radius(op, inst.y);
            let is_union = is_union_op(op);

            // 1. Сохранение значения — дословно порог липшицева критерия
            // |a - b| > k + 2R. Объединение оставляет МЕНЬШИЙ операнд,
            // пересечение — больший.
            let left_greater = left - right > k + 2.0 * radius;
            let right_greater = right - left > k + 2.0 * radius;
            var code = MARK_NONE;
            var victim_left = false;

            if (left_greater || right_greater) {
                code = MARK_VALUE;
                victim_left = select(right_greater, left_greater, is_union);
            } else {
                // Пересечение сводится к объединению заменой операндов на
                // -a, -b, потому что si(a, b) = -su(-a, -b). Дальше всё
                // выписано для объединения и годится обеим операциям.
                let a = select(-left, left, is_union);
                let b = select(-right, right, is_union);

                let is_smooth = k > 0.0;
                if (is_smooth) { stat_smooth_seen = stat_smooth_seen + 1u; }

                // 2. Знаковое правило Duff. «Заведомо внутри» — a + R <= 0,
                // «заведомо снаружи» — a - R >= k.
                //
                // Порог «снаружи» — это ровно k, и обе операции разбираются
                // одной формулой, потому что у жёсткой k = 0. При k = 0 это
                // дословно классический булев критерий (тот же, что в
                // prune_list_interval, только по липшицевой оценке вместо
                // интервальной): знак min определён, если один операнд заведомо
                // внутри (тогда min внутри) или заведомо снаружи (тогда его
                // вклада в знак нет).
                //
                // У ГЛАДКОЙ тот же порог поднимается вместе с k. «Внутри»
                // безопасно и так: добавка бленда только уменьшает значение,
                // знак остаться не может. А вот «снаружи» без запаса k врёт —
                // su(0.20, 0.30) при k = 1 равно -0.0025, хотя оба операнда
                // снаружи (максимум добавки k/4 достигается при a = b).
                //
                // Порог именно k, и он ТОЧНЫЙ, а не с запасом: при a = k - eps
                // и b -> +0 получаем phi = (k - a + b)^2 / (4k) -> eps^2/(4k),
                // что уже больше b, то есть знак ломается. Пример: k = 1,
                // a = 0.9, b = 0.001 дают su = -0.00155 при положительном b.
                // И наоборот, при a >= k добавка гасится в ноль всякий раз,
                // когда b <= 0, а при b > 0 всегда b > phi, — знак снова
                // определяется одним min.
                let a_in  = a + radius <= 0.0;
                let b_in  = b + radius <= 0.0;
                let a_out = a - radius >= k;
                let b_out = b - radius >= k;

                if (a_in || b_in || a_out || b_out) {
                    code = MARK_SIGN;
                    victim_left = a_out || b_in; // выбрасываем ЛЕВЫЙ
                } 
                else if (is_smooth) {
                    // let d     = abs(a - b);
                    // let slack = max(k - max(d - radius, 0.0f), 0.0f);
                    // let res = -((min(a, b) - radius) * (4.0f * k) - slack * slack) < 0.0;
                    if (false) {
                        code = MARK_SIGN;
                        victim_left = a < b; // выбрасываем ЛЕВЫЙ
                    } else {
                        // Ненулевой бленд: он потребляет ЗНАЧЕНИЯ операндов, поэтому
                        // ничего знакового ни на нём, ни под ним делать нельзя.
                        code = MARK_BLOCK;
                        stat_smooth_live = stat_smooth_live + 1u;
                    }
                }
                // Жёсткая операция, которой нечего выбросить, так и остаётся
                // MARK_NONE: цепочка из min/max знак пропускает насквозь,
                // запирать потомков ей незачем.
            }

            // aux — сторона жертвы, и больше ничего: единственный, кто его
            // читает, — проход 2, и только на позиции, которую собирается
            // погасить. У MARK_NONE и MARK_BLOCK он остаётся нулевым.
            if (code == MARK_VALUE || code == MARK_SIGN) { stat_pruned_marks = 1u; }
            mark_set(bbase, words, i, code, victim_left);

            // Значение ВСЕГДА по истинным операндам, независимо от разметки:
            // отсечение исполняет только проход 2, а порог |a - b| > k + 2R у
            // предка обязан считаться на неупрощённом операнде.
            stack[sp - 1u] = binary_op_k(op, k, left, right);
        }
    }
    if (sp == 0u) { return 0.0; }
    return stack[0];
}


// ------------------------------------------------------------------
// Проход 2: сверху вниз, коммит. Полей не считает вообще — только читает
// разметку, решает, кому из размеченных отсечений положено сработать, и
// гасит биты.
//
// ОТКУДА БЕРЁТСЯ УСЛОВИЕ НА ПРЕДКОВ. Отсекать по знаку под операцией можно
// только если каждый бленд на пути к корню выключен: цепочка из min и max
// определяет знак результата по одним знакам операндов, а ненулевой — нет.
// Поддерево в постфиксной записи занимает непрерывный диапазон, и идём мы
// НАЗАД, поэтому все предки позиции уже пройдены. Значит, достаточно помнить
// минимальное начало среди встреченных ненулевых блендов: позиция под запретом
// ровно тогда, когда она не левее этого начала. Вложенные бленды сами по себе
// ничего не добавляют (у внешнего начало меньше), а бленд из соседнего
// поддерева стоит правее и его начало больше текущей позиции — то есть одного
// u32 хватает на точное условие, без стека и без запаса.
//
// Начало хранится ЛОКАЛЬНОЙ позицией, а не глобальным индексом: порядок у них
// один и тот же, зато сравнение локальных не требует читать список. Двоичный
// поиск платится один раз на ненулевой бленд вместо одного чтения на позицию.
//
// Наткнуться на уже погашенный узел не страшно: если его погасил предок, то
// вместе со всем его поддеревом, а значит и с жертвой, которую он собирался
// гасить, — повторное «И с дополнением» ничего не меняет.
// ------------------------------------------------------------------
fn commit_boolean_smooth(offset : u32, count : u32, bbase : u32, words : u32,
                         no_block : bool) {
    atomicAdd(&globals.cells_total, 1u);
    // 0xffffffff = «ненулевых блендов над нами нет»: любая позиция меньше него.
    var block_lo = 0xffffffffu;
    for (var d = 0u; d < count; d = d + 1u) {
        let i = count - 1u - d;
        // Узел, уже выброшенный предком, не нужен ни для чего: гасить под ним
        // нечего (его поддерево ушло вместе с ним), и мешать потомкам он тоже
        // больше не может. Поэтому проверка стоит ПЕРВОЙ: она снимает и
        // два чтения кода разметки, и, главное, двоичный поиск с гашением
        // диапазона в сотни слов. Идём мы от корня к листьям, поэтому таких
        // позиций тем больше, чем агрессивнее отсечение, — и именно они, а не
        // сама двухпроходность, составляли почти всю разницу во времени с
        // однопроходным критерием.
        if (!test_bit(bbase, i)) { continue; }
        let blocked = i >= block_lo;
        let code = mark_get(bbase, words, i);

        if (code == MARK_BLOCK) {
            if (!no_block) { block_lo = min(block_lo, subtree_lo(offset, i)); }
            continue;
        }
        if (code == MARK_NONE) {
            // Ни жертвы, ни блокировки. Сюда попадают примитивы (проход
            // 1 размётку на них не пишет) и жёсткие операции без выигравшей
            // ветви. Цепочка из min/max знак пропускает насквозь, поэтому
            // запирать потомков не нужно — этим занят только MARK_BLOCK.
            continue;
        }
        if (code == MARK_SIGN) {
            stat_sign_seen = stat_sign_seen + 1u;
            if (blocked) {
                // Жертва есть, но права выбросить её нет: узел остаётся жить со
                // своим настоящим оператором и обоими операндами.
                stat_sign_refused = stat_sign_refused + 1u;
                continue;
            }
        }

        // Позиции операндов восстанавливаются по структуре: проход 1 список
        // не менял, поэтому корень правого операнда — это i-1, а корень
        // левого — позиция прямо перед началом правого поддерева. Бинарная
        // операция раньше третьей позиции означала бы битую RPN, а проход 1
        // на такой размётку и не записывает.
        if (i < 2u) { continue; }
        let right_local = i - 1u;
        var victim = right_local;
        if (test_bit(bbase + BAND_AUX * words, i)) {
            let right_lo = subtree_lo(offset, right_local);
            if (right_lo == 0u) { continue; } // левого операнда нет: битая RPN
            victim = right_lo - 1u;
        }
        let victim_lo = subtree_lo(offset, victim);
        clear_bit(bbase, i); // сам узел операции был активен: проверка выше
        let removed = clear_range_count(bbase, victim_lo, victim) + 1u;
        if (code == MARK_VALUE) {
            stat_value_commits = stat_value_commits + 1u;
        } else {
            stat_sign_commits = stat_sign_commits + 1u;
            stat_sign_removed = stat_sign_removed + removed;
        }
    }
    if (block_lo == 0xffffffffu) {
        atomicAdd(&globals.cells_clean, 1u);
    } else {
        atomicAdd(&globals.sign_in_dirty, stat_sign_commits);
    }
}

// Границы узла в мировых координатах: якорь ijk задан в единицах мелкой
// сетки, узел уровня `level` занимает 2^(level_max - level) таких единиц
// по каждой оси.
// Доля стороны вокселя, на которую он раздувается С КАЖДОЙ стороны перед
// отсечением. Ровно то же, что oversized = true в voxel_domain()
// (voxel_tree.hpp): запас, чтобы решения на границе не зависели от
// округления. Эталонный построитель раздувает воксель для ОБОИХ критериев,
// поэтому и здесь это общий для них шаг: без него мы отсекаем чуть больше,
// чем эталон (у него R в 1.002 раза больше, а интервалы шире).
const VOXEL_OVERSIZE : f32 = 0.001;

struct VoxelBounds { lo : vec3f, hi : vec3f };

fn voxel_bounds(packed_ijk : u32, level : u32) -> VoxelBounds {
    let ijk = vec3f(vec3u(packed_ijk & 1023u, (packed_ijk >> 10u) & 1023u,
                          (packed_ijk >> 20u) & 1023u));
    let cells = f32(1u << params.level_max);
    let extent = params.aabb_max - params.aabb_min;
    let side = f32(1u << (params.level_max - level));
    let lo = params.aabb_min + (ijk / cells) * extent;
    let hi = lo + (side / cells) * extent;
    let pad = (hi - lo) * VOXEL_OVERSIZE;
    var b : VoxelBounds;
    b.lo = lo - pad;
    b.hi = hi + pad;
    return b;
}

struct VoxelBox { center : vec3f, radius : f32 };

fn voxel_box(packed_ijk : u32, level : u32) -> VoxelBox {
    let b = voxel_bounds(packed_ijk, level);
    var box : VoxelBox;
    box.center = 0.5 * (b.lo + b.hi);
    // R — ПОЛОВИНА ДИАГОНАЛИ раздутого вокселя, как sqrt(vr . vr) в
    // C++-версии, где vr берётся у того же раздутого домена.
    box.radius = 0.5 * length(b.hi - b.lo);
    return box;
}

// Тот же воксель, но как брусок для интервальной арифметики: булев
// критерий оценивает выражение на ВСЁМ вокселе, а не в одной точке.
fn voxel_iv(packed_ijk : u32, level : u32) -> IV3 {
    let b = voxel_bounds(packed_ijk, level);
    var v : IV3;
    v.x = vec2f(b.lo.x, b.hi.x);
    v.y = vec2f(b.lo.y, b.hi.y);
    v.z = vec2f(b.lo.z, b.hi.z);
    return v;
}

// Размер рабочей группы прохода построения; совпадает с kWorkgroupSize в
// VoxelTreeBuilder.h, потому что по нему же считается размер сетки.
const WG_SIZE : u32 = 64u;

// ------------------------------------------------------------------
// Обнуляет счётчики тех буферов, в которые текущий проход будет писать, и
// готовит размер сетки для него самого. Идёт отдельным однопоточным
// проходом перед каждым проходом построения, поэтому упорядочен
// относительно него границей прохода. Буферы, которые на этом проходе
// читаются (вторая половина каждого пинг-понга), не затрагиваются.
// ------------------------------------------------------------------
@compute @workgroup_size(1)
fn reset_out() {
    atomicStore(&task_out.count, 0u);
    atomicStore(&frontier_out.count, 0u);
    atomicStore(&globals.bitmask_count, 0u);

    // Задачи для ближайшего build() сложил предыдущий проход, поэтому их
    // число не знает ни CPU, ни кодировщик команд, — а здесь оно просто
    // лежит в памяти. Обрезка по maxComputeWorkgroupsPerDimension
    // сохраняется: то, что не покрыла сетка, разбирает цикл с шагом внутри
    // build(). Ноль задач даёт нулевую сетку, то есть уровень, на котором
    // дерево уже целиком выродилось в листья, не стоит вообще ничего.
    dispatch_args.x = min((task_in.count + WG_SIZE - 1u) / WG_SIZE, params.max_workgroups);
    dispatch_args.y = 1u;
    dispatch_args.z = 1u;
}

// Обрабатывает один узел: отсекает его список и решает, лист это или он
// делится на 8 детей. Вынесено из точки входа, потому что она проходит по
// задачам циклом с шагом (см. build()), и ранние return'ы должны выходить
// из обработки ОДНОГО узла, а не из всего цикла.
fn process_node(node_i : u32) {
    let node = nodes[node_i];
    let level = node.y & LEVEL_MASK;
    let offset = node.z; // смещение в frontier_in
    let count = node.w;

    // Своя полоса битовой маски на поток: она живёт только внутри прохода,
    // поэтому счётчик обнуляется перед каждым проходом и полосы никогда не
    // пересекаются между потоками. Двухпроходному критерию полос нужно
    // SMOOTH_BANDS, и лежат они подряд в одном выделении.
    // Старший байт criterion — временный выключатель блокировки (замер того,
    // насколько она вообще нужна). Сам критерий лежит в младшем байте.
    let crit = params.criterion & 0xffu;
    let no_block = (params.criterion & 0x100u) != 0u;
    let smooth_crit = crit == CRIT_BOOLEAN_SMOOTH;
    let bands = select(1u, SMOOTH_BANDS, smooth_crit);
    let words = (count + 31u) >> 5u;
    let bbase = atomicAdd(&globals.bitmask_count, words * bands);
    atomicMax(&globals.bitmask_peak, bbase + words * bands);
    if (bbase + words * bands > params.bitmask_cap) {
        atomicOr(&globals.error, ERR_BITMASK);
        return;
    }
    // Изначально активны все позиции. Хвост последнего слова гасится сразу,
    // иначе он попал бы в countOneBits() ниже.
    for (var w = 0u; w < words; w = w + 1u) {
        final_indices[params.bitmask_base + bbase + w] = 0xFFFFFFFFu;
    }
    let tail = count & 31u;
    if (tail != 0u) {
        final_indices[params.bitmask_base + bbase + words - 1u] = (1u << tail) - 1u;
    }
    // Полосы разметки, наоборот, начинают пустыми: проход 1 пишет их только
    // на бинарных операциях, всё остальное так и остаётся MARK_NONE.
    for (var w = words; w < words * bands; w = w + 1u) {
        final_indices[params.bitmask_base + bbase + w] = 0u;
    }

    // Отсечение и отбраковка пустых ячеек — по выбранному критерию. Признак
    // «поверхности здесь нет» у них разный: липшицев и Boolean+smooth считают
    // скаляр в центре и смотрят |f(центр)| > R, булев ведёт интервал на всём
    // вокселе и смотрит, пересекает ли тот ноль.
    //
    // Воксель считается ВНУТРИ веток: box и iv строятся из одних voxel_bounds,
    // и общий box снаружи заставил бы булев путь считать границы дважды, а
    // sqrt в радиусе ему вообще не нужен.
    var cell_empty = false;
    if (smooth_crit) {
        let box = voxel_box(node.x, level);
        // Значение здесь — от НЕупрощённого выражения (проход 1 ничего не
        // гасит), поэтому пустую ячейку видно ещё до коммита, и второй проход
        // на ней вообще не запускается.
        stat_smooth_seen = 0u;
        stat_smooth_live = 0u;
        stat_sign_seen = 0u;
        stat_sign_refused = 0u;
        stat_value_commits = 0u;
        stat_sign_commits = 0u;
        stat_sign_removed = 0u;
        stat_pruned_marks = 0u;
        let root = prune_list_boolean_smooth(box.center, box.radius, offset, count, bbase, words);
        cell_empty = abs(root) > box.radius;
        if (!cell_empty) {
            if (stat_pruned_marks != 0u) {
                commit_boolean_smooth(offset, count, bbase, words, no_block);
            } else {
                // Жертв нет — коммит не погасил бы ни бита. Учёт ячеек
                // сохраняется точь-в-точь: раз ничего не гасилось, все
                // позиции активны, и ячейка чиста ровно тогда, когда
                // ненулевых блендов не встретилось вовсе. Отказов тоже
                // ноль — отказывать было некому.
                atomicAdd(&globals.cells_total, 1u);
                if (stat_smooth_live == 0u) { atomicAdd(&globals.cells_clean, 1u); }
            }
        }
        if (stat_smooth_seen != 0u || stat_sign_seen != 0u || stat_value_commits != 0u) {
            atomicAdd(&globals.smooth_seen, stat_smooth_seen);
            atomicAdd(&globals.smooth_live, stat_smooth_live);
            atomicAdd(&globals.sign_seen, stat_sign_seen);
            atomicAdd(&globals.sign_refused, stat_sign_refused);
            atomicAdd(&globals.value_commits, stat_value_commits);
            atomicAdd(&globals.sign_commits, stat_sign_commits);
            atomicAdd(&globals.sign_removed, stat_sign_removed);
        }
    } else if (crit == CRIT_BOOLEAN || crit == CRIT_KEETER) {
        // Обход один и тот же, различается только правило отсечения.
        let iv = prune_list_interval(voxel_iv(node.x, level), offset, count, bbase,
                                     crit == CRIT_KEETER);
        cell_empty = iv.x > 0.0 || iv.y < 0.0;
    } else {
        let box = voxel_box(node.x, level);
        let root = prune_list(box.center, box.radius, offset, count, bbase);
        cell_empty = abs(root) > box.radius;
    }

    // Пустой лист — это w = 0, ровно то, что рендерер пропускает. В объём он
    // входит наравне с прочими, а в сумму сложности даёт ноль.
    if (cell_empty) {
        nodes[node_i] = vec4u(node.x, node.y | LEAF_BIT, 0u, 0u);
        atomicAdd(&globals.l_cnt[level], 1u);
        return;
    }

    var m = 0u;
    for (var w = 0u; w < words; w = w + 1u) {
        m = m + countOneBits(final_indices[params.bitmask_base + bbase + w]);
    }

    if (m <= params.lt || level >= params.level_max) {
        // Готовый лист: его список идёт в буфер, который не переиспользуется.
        if (m != 0u) { atomicAdd(&globals.leaves, 1u); }
        atomicAdd(&globals.l_cnt[level], 1u);
        atomicAdd(&globals.l_sum[level], m);
        atomicMax(&globals.l_max, m);
        let dst = atomicAdd(&globals.final_count, m);
        if (dst + m > params.final_cap) {
            atomicOr(&globals.error, ERR_FINAL);
            return;
        }
        var written = 0u;
        for (var q = 0u; q < count; q = q + 1u) {
            if ((final_indices[params.bitmask_base + bbase + (q >> 5u)] & (1u << (q & 31u))) != 0u) {
                final_indices[dst + written] = frontier_in.data[offset + q];
                written = written + 1u;
            }
        }
        nodes[node_i] = vec4u(node.x, node.y | LEAF_BIT, dst, m);
        return;
    }

    // Узел делится: список уходит во фронт, откуда его на следующем проходе
    // читают 8 детей. Все восемь пользуются одной копией.
    let fdst = atomicAdd(&frontier_out.count, m);
    let nbase = atomicAdd(&globals.node_count, 8u);
    let tdst = atomicAdd(&task_out.count, 8u);
    if (fdst + m > params.frontier_cap || nbase + 8u > params.node_cap
        || tdst + 8u > params.task_cap) {
        atomicOr(&globals.error,
                 select(0u, ERR_FRONTIER, fdst + m > params.frontier_cap)
                 | select(0u, ERR_NODE, nbase + 8u > params.node_cap)
                 | select(0u, ERR_TASK, tdst + 8u > params.task_cap));
        return;
    }
    var written = 0u;
    for (var q = 0u; q < count; q = q + 1u) {
        if ((final_indices[params.bitmask_base + bbase + (q >> 5u)] & (1u << (q & 31u))) != 0u) {
            frontier_out.data[fdst + written] = frontier_in.data[offset + q];
            written = written + 1u;
        }
    }

    let child_level = level + 1u;
    let half = 1u << (params.level_max - child_level);
    let i0 = node.x & 1023u;
    let j0 = (node.x >> 10u) & 1023u;
    let k0 = (node.x >> 20u) & 1023u;
    for (var c = 0u; c < 8u; c = c + 1u) {
        let ci = i0 + ((c >> 0u) & 1u) * half;
        let cj = j0 + ((c >> 1u) & 1u) * half;
        let ck = k0 + ((c >> 2u) & 1u) * half;
        // Дети рождаются листьями, указывающими на список фронта родителя;
        // следующий проход перезапишет их z/w собственным результатом.
        nodes[nbase + c] = vec4u(ci | (cj << 10u) | (ck << 20u),
                                 child_level | LEAF_BIT, fdst, m);
        task_out.data[tdst + c] = nbase + c;
    }

    // Родитель стал внутренним узлом: z — база детей, w не используется.
    nodes[node_i] = vec4u(node.x, child_level - 1u, nbase, 0u);
}

// ------------------------------------------------------------------
// Точка входа прохода построения. Размер сетки берётся из dispatch_args,
// который заполнил reset_out, и потому равен настоящему числу задач — но
// не более maxComputeWorkgroupsPerDimension (65535). Поэтому поток берёт
// не одну задачу, а идёт по списку с шагом во весь диспатч: сетка любого
// разрешённого размера покрывает любое число задач.
// ------------------------------------------------------------------
@compute @workgroup_size(WG_SIZE)
fn build(@builtin(global_invocation_id) gid : vec3u,
         @builtin(num_workgroups) groups : vec3u) {
    let stride = groups.x * WG_SIZE;
    for (var t = gid.x; t < task_in.count; t = t + stride) {
        process_node(task_in.data[t]);
    }
}
